---
import type { Comment } from '../../types';

interface Props {
  comment: Comment;
  depth?: number;
  entityId?: string;
  entityType?: 'article' | 'book' | 'course';
}

const { comment, depth = 0, entityId = '', entityType = 'article' } = Astro.props;
const hasReplies = comment.replies && comment.replies.length > 0;
---

<div class={`comment-item group relative ${depth > 0 ? 'mr-4 sm:mr-8 mt-4 pr-3 sm:pr-5 border-r-2 border-black/10 dark:border-white/10' : 'mb-6'}`}>
  <!-- Comment Bubble -->
  <div class="p-5 rounded-2xl bg-black/[0.02] dark:bg-white/[0.03] border border-black/5 dark:border-white/5 hover:border-black/10 dark:hover:border-white/10 transition-all duration-200">
    <!-- Comment Header -->
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-apple-blue/10 dark:bg-apple-blue-dark/20 text-apple-blue dark:text-apple-blue-dark flex items-center justify-center text-xs font-bold border border-apple-blue/20">
          {comment.authorName ? comment.authorName[0] : 'ک'}
        </div>
        <div>
          <h4 class="text-sm font-bold text-neutral-900 dark:text-white flex items-center gap-2">
            <span>{comment.authorName}</span>
            {
              comment.authorEmail && comment.authorEmail.includes('shafieiabadi') && (
                <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-apple-blue text-white shadow-xs">
                  نویسنده
                </span>
              )
            }
          </h4>
          <span class="text-[11px] text-neutral-400 dark:text-neutral-500">
            {new Date(comment.createdAt).toLocaleDateString('fa-IR', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              hour: '2-digit',
              minute: '2-digit',
            })}
          </span>
        </div>
      </div>

      <!-- Reply Trigger Button -->
      <button
        type="button"
        class="reply-toggle-btn text-xs font-semibold text-apple-blue dark:text-apple-blue-dark hover:underline flex items-center gap-1 focus:outline-none"
        data-comment-id={comment.id}
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
        </svg>
        <span>پاسخ</span>
      </button>
    </div>

    <!-- Comment Body -->
    <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
      {comment.content}
    </p>

    <!-- Inline Reply Form (Hidden by default) -->
    <div id={`reply-form-${comment.id}`} class="reply-form-container hidden mt-4 pt-4 border-t border-black/5 dark:border-white/5">
      <form
        class="comment-reply-form space-y-3"
        data-parent-id={comment.id}
        data-entity-id={entityId}
        data-entity-type={entityType}
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <input
            type="text"
            name="guestName"
            required
            placeholder="نام شما *"
            class="reply-name w-full px-3.5 py-2 text-xs rounded-xl bg-white dark:bg-neutral-900 border border-black/10 dark:border-white/10 focus:ring-2 focus:ring-apple-blue/50 focus:outline-none"
          />
          <input
            type="email"
            name="email"
            required
            placeholder="ایمیل شما *"
            class="reply-email w-full px-3.5 py-2 text-xs rounded-xl bg-white dark:bg-neutral-900 border border-black/10 dark:border-white/10 focus:ring-2 focus:ring-apple-blue/50 focus:outline-none"
          />
        </div>
        <textarea
          name="text"
          rows="2"
          required
          placeholder="متن پاسخ شما..."
          class="reply-text w-full px-3.5 py-2 text-xs rounded-xl bg-white dark:bg-neutral-900 border border-black/10 dark:border-white/10 focus:ring-2 focus:ring-apple-blue/50 focus:outline-none"
        ></textarea>
        <div class="flex items-center justify-end gap-2">
          <button
            type="button"
            class="cancel-reply-btn px-3 py-1.5 text-xs text-neutral-500 hover:text-neutral-800 dark:hover:text-neutral-200"
            data-comment-id={comment.id}
          >
            انصراف
          </button>
          <button
            type="submit"
            class="reply-submit-btn px-4 py-1.5 text-xs font-semibold rounded-full bg-apple-blue hover:bg-apple-blue-hover text-white dark:bg-apple-blue-dark transition-colors"
          >
            ارسال پاسخ
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Recursive Child Replies (Unlimited Depth) -->
  {
    hasReplies && (
      <div class="comment-replies mt-2">
        {comment.replies!.map((reply) => (
          <Astro.self comment={reply} depth={depth + 1} entityId={entityId} entityType={entityType} />
        ))}
      </div>
    )
  }
</div>
