---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="نگارش و انتشار مقاله جدید" activeSection="articles">
  <div class="max-w-5xl mx-auto space-y-6">
    
    <!-- Page Header -->
    <div class="flex items-center justify-between pb-4 border-b border-black/5 dark:border-white/10">
      <div>
        <h1 class="text-2xl font-black text-neutral-950 dark:text-white">
          نگارش مقاله جدید
        </h1>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
          محتوا و جزئیات سئو مقاله را وارد کرده و با ویرایشگر هوشمند متن آن را تدوین نمایید
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/articles"
          class="px-4 py-2 rounded-full border border-black/10 dark:border-white/10 text-xs font-semibold text-neutral-700 dark:text-neutral-300 hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
        >
          انصراف
        </a>
        <button
          type="button"
          id="btn-save-draft"
          class="px-4 py-2 rounded-full bg-black/5 dark:bg-white/10 text-xs font-semibold text-neutral-800 dark:text-neutral-200 hover:bg-black/10 dark:hover:bg-white/20 transition-colors"
        >
          ذخیره پیش‌نویس
        </button>
        <button
          type="button"
          id="btn-publish"
          class="px-5 py-2 rounded-full bg-apple-blue hover:bg-blue-600 text-white text-xs font-bold shadow-md shadow-apple-blue/25 transition-all duration-200"
        >
          انتشار مقاله
        </button>
      </div>
    </div>

    <!-- Article Editor Form -->
    <form id="article-form" class="space-y-6">
      
      <!-- General Metadata Card -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm space-y-5">
        <h2 class="text-sm font-bold text-neutral-900 dark:text-white border-b border-black/5 dark:border-white/10 pb-3">
          مشخصات اصلی و سئو
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label for="title" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              عنوان مقاله <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="title"
              name="title"
              required
              placeholder="مثال: راهنمای جامع معماری تمیز در دات‌نت ۹"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>

          <div>
            <label for="slug" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              نامک آدرس (Slug) <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="slug"
              name="slug"
              required
              dir="ltr"
              placeholder="clean-architecture-dotnet-9"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <div>
            <label for="category" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              دسته‌بندی <span class="text-rose-500">*</span>
            </label>
            <select
              id="category"
              name="category"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            >
              <option value="معماری نرم‌افزار">معماری نرم‌افزار</option>
              <option value="طراحی سیستم">طراحی سیستم</option>
              <option value="کیفیت و تست">کیفیت و تست</option>
              <option value="میکروسرویس">میکروسرویس</option>
              <option value="فرانت‌اند مدرن">فرانت‌اند مدرن</option>
              <option value="پایگاه داده">پایگاه داده</option>
            </select>
          </div>

          <div>
            <label for="readTime" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              مدت زمان تخمینی مطالعه
            </label>
            <input
              type="text"
              id="readTime"
              name="readTime"
              placeholder="مثال: ۱۰ دقیقه"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>

          <div>
            <label for="tags" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              برچسب‌ها (با کاما جدا کنید)
            </label>
            <input
              type="text"
              id="tags"
              name="tags"
              placeholder="دات‌نت، Clean Architecture، C#"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>
        </div>

        <div>
          <label for="coverImage" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
            آدرس تصویر کاور (Cover Image URL)
          </label>
          <input
            type="url"
            id="coverImage"
            name="coverImage"
            dir="ltr"
            placeholder="https://images.unsplash.com/photo-..."
            class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
          />
        </div>

        <div>
          <label for="summary" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
            چکیده و خلاصه مقاله (توضیحات سئو) <span class="text-rose-500">*</span>
          </label>
          <textarea
            id="summary"
            name="summary"
            rows="2"
            required
            placeholder="خلاصه کوتاهی از موضوع و ارزش‌های کلیدی مقاله..."
            class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all resize-none"
          ></textarea>
        </div>
      </div>

      <!-- Rich Text Editor (WYSIWYG) Card -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-black/5 dark:border-white/10 pb-3">
          <div class="flex items-center gap-2">
            <h2 class="text-sm font-bold text-neutral-900 dark:text-white">
              محتوای اصلی مقاله (Rich Text Editor - TinyMCE / WYSIWYG)
            </h2>
          </div>
          <span class="text-[11px] text-neutral-400">
            پشتیبانی از فرمت‌های غنی، کد، جداول و تصاویر
          </span>
        </div>

        <!-- Custom Quick Action Toolbar -->
        <div class="flex flex-wrap items-center gap-1.5 p-2 bg-neutral-50 dark:bg-neutral-800 rounded-2xl border border-black/5 dark:border-white/10 text-neutral-700 dark:text-neutral-300 text-xs">
          <button type="button" class="toolbar-btn px-2.5 py-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 font-bold" data-command="bold">B</button>
          <button type="button" class="toolbar-btn px-2.5 py-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 italic" data-command="italic">I</button>
          <button type="button" class="toolbar-btn px-2.5 py-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 underline" data-command="underline">U</button>
          <div class="w-[1px] h-4 bg-neutral-300 dark:bg-neutral-700 mx-1"></div>
          <button type="button" class="toolbar-btn px-2.5 py-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/10" data-command="formatBlock" data-val="H2">H2</button>
          <button type="button" class="toolbar-btn px-2.5 py-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/10" data-command="formatBlock" data-val="H3">H3</button>
          <div class="w-[1px] h-4 bg-neutral-300 dark:bg-neutral-700 mx-1"></div>
          <button type="button" class="toolbar-btn px-2.5 py-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/10" data-command="insertUnorderedList">• لیست</button>
          <button type="button" class="toolbar-btn px-2.5 py-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/10" data-command="insertOrderedList">۱. شماره‌دار</button>
          <div class="w-[1px] h-4 bg-neutral-300 dark:bg-neutral-700 mx-1"></div>
          <button type="button" class="toolbar-btn px-2.5 py-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 font-mono" data-command="formatBlock" data-val="PRE">&lt;/&gt; کد</button>
          <button type="button" class="toolbar-btn px-2.5 py-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/10" id="btn-insert-link">🔗 درج لینک</button>
        </div>

        <!-- Editable WYSIWYG Content Area -->
        <div
          id="editor-content"
          contenteditable="true"
          class="min-h-[350px] p-5 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-apple-blue prose dark:prose-invert max-w-none text-sm leading-relaxed"
        >
          <h2>مقدمه و اهداف این مقاله</h2>
          <p>در این بخش متن تخصصی خود را بنویسید. تمامی استایل‌ها، عناوین و بلوک‌های کد به صورت استاندارد ذخیره خواهند شد.</p>
          <blockquote>
            معماری تمیز به سیستم اجازه می‌دهد در طول زمان بدون افت کیفیت و افزایش پیچیدگی نگهداری رشد کند.
          </blockquote>
        </div>

        <textarea id="hidden-content" name="content" class="hidden"></textarea>
      </div>

    </form>
  </div>
</AdminLayout>

<script>
  // Simple Rich Text Editor Controls & Submission Mock
  const editor = document.getElementById('editor-content');
  const hiddenContent = document.getElementById('hidden-content') as HTMLTextAreaElement;
  const publishBtn = document.getElementById('btn-publish');
  const draftBtn = document.getElementById('btn-save-draft');

  document.querySelectorAll('.toolbar-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const command = btn.getAttribute('data-command');
      const val = btn.getAttribute('data-val') || '';
      if (command) {
        document.execCommand(command, false, val);
        editor?.focus();
      }
    });
  });

  document.getElementById('btn-insert-link')?.addEventListener('click', () => {
    const url = prompt('آدرس اینترنتی لینک را وارد کنید (https://...):');
    if (url) {
      document.execCommand('createLink', false, url);
    }
  });

  const handleSave = (isDraft: boolean) => {
    const titleInput = document.getElementById('title') as HTMLInputElement;
    if (!titleInput?.value.trim()) {
      alert('لطفاً عنوان مقاله را وارد نمایید.');
      titleInput?.focus();
      return;
    }

    if (hiddenContent && editor) {
      hiddenContent.value = editor.innerHTML;
    }

    alert(
      isDraft
        ? 'پیش‌نویس مقاله با موفقیت ذخیره شد.'
        : 'مقاله با موفقیت ذخیره شد. در فاز اتصال بک‌اند، این فرم به API متصل خواهد شد.'
    );
  };

  publishBtn?.addEventListener('click', () => handleSave(false));
  draftBtn?.addEventListener('click', () => handleSave(true));
</script>
