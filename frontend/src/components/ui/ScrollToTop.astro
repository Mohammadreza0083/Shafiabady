---
---

<button
  id="scroll-to-top-btn"
  type="button"
  aria-label="بازگشت به بالای صفحه"
  class="fixed bottom-6 left-6 z-50 w-12 h-12 rounded-full apple-glass border border-black/10 dark:border-white/15 text-neutral-800 dark:text-neutral-100 shadow-apple-lg hover:shadow-apple-glow flex items-center justify-center opacity-0 pointer-events-none translate-y-4 transition-all duration-300 ease-out focus:outline-none focus:ring-2 focus:ring-apple-blue/50 group cursor-pointer"
>
  <svg
    class="w-5 h-5 transition-transform duration-200 group-hover:-translate-y-0.5 text-neutral-800 dark:text-neutral-100 group-hover:text-apple-blue dark:group-hover:text-apple-blue-dark"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2.5"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
  </svg>
</button>

<script>
  function setupScrollToTop() {
    const btn = document.getElementById('scroll-to-top-btn');
    if (!btn) return;

    const footer = document.querySelector('footer');

    const checkScrollPosition = () => {
      let isNearFooter = false;

      if (footer) {
        const footerRect = footer.getBoundingClientRect();
        // Distance from bottom of viewport to the top of footer
        const distanceToFooterTop = footerRect.top - window.innerHeight;
        // Show only when distance is exactly 150px or less away from top of footer
        isNearFooter = distanceToFooterTop <= 150;
      } else {
        const scrollDistanceToBottom =
          document.documentElement.scrollHeight - (window.scrollY + window.innerHeight);
        isNearFooter = scrollDistanceToBottom <= 150;
      }

      // Also ensure the user has scrolled down somewhat (e.g. at least 300px from top) so it doesn't show immediately on short pages
      const hasScrolledDown = window.scrollY > 200;

      if (isNearFooter && hasScrolledDown) {
        btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      } else {
        btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      }
    };

    btn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    });

    window.addEventListener('scroll', checkScrollPosition, { passive: true });
    window.addEventListener('resize', checkScrollPosition, { passive: true });
    checkScrollPosition();
  }

  // Support both DOMContentLoaded and Astro page loads
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupScrollToTop);
  } else {
    setupScrollToTop();
  }
  document.addEventListener('astro:page-load', setupScrollToTop);
</script>
