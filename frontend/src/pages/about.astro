<script>
  // Slide Indicator Active State Updater with Intersection Observer
  function initSlideIndicators() {
    const container = document.getElementById('slides-container');
    const sections = document.querySelectorAll('.slide-section');
    const dots = document.querySelectorAll('.slide-nav-dot');

    if (!container || !sections.length || !dots.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const currentId = entry.target.id;
            dots.forEach((dot) => {
              const targetSlide = dot.getAttribute('data-slide');
              if (targetSlide === currentId) {
                dot.classList.add('bg-apple-blue', 'scale-125');
                dot.classList.remove('bg-neutral-300', 'dark:bg-neutral-700');
              } else {
                dot.classList.remove('bg-apple-blue', 'scale-125');
                dot.classList.add('bg-neutral-300', 'dark:bg-neutral-700');
              }
            });
          }
        });
      },
      {
        root: container,
        threshold: 0.5,
      }
    );

    sections.forEach((section) => observer.observe(section));

    // Smooth navigation click
    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = dot.getAttribute('data-slide');
        const targetElement = document.getElementById(targetId || '');
        if (targetElement) {
          targetElement.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  }

  // Initialize on load and on client-side navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSlideIndicators);
  } else {
    initSlideIndicators();
  }
  document.addEventListener('astro:page-load', initSlideIndicators);
</script>
