---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ui/ScrollToTop.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'دکتر محمد حسین شفیعآبادی | پلتفرم تخصصی معماری نرم‌افزار و دات‌نت',
  description = 'پلتفرم برندینگ شخصی و آموزش تخصصی مهندسی نرم‌افزار، معماری تمیز (Clean Architecture)، دات‌نت و وب مدرن.',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="fa" dir="rtl" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0071E3" />

    <!-- Anti-FOUC Theme Initializer (Sync inline script with IRST UTC+3:30 18:00 Auto Dark Mode logic) -->
    <script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem('theme');
          if (savedTheme === 'dark') {
            document.documentElement.classList.add('dark');
            return;
          }
          if (savedTheme === 'light') {
            document.documentElement.classList.remove('dark');
            return;
          }

          // If no stored preference, evaluate Iran Standard Time (IRST / UTC+3:30)
          const now = new Date();
          let isNight = false;
          try {
            const tehranTimeString = new Intl.DateTimeFormat('en-US', {
              timeZone: 'Asia/Tehran',
              hour: 'numeric',
              hour12: false,
            }).format(now);
            const tehranHour = parseInt(tehranTimeString, 10);
            isNight = tehranHour >= 18 || tehranHour < 6;
          } catch (e) {
            const utcHours = now.getUTCHours();
            const utcMinutes = now.getUTCMinutes();
            const iranTotalMinutes = utcHours * 60 + utcMinutes + 210;
            const iranHour = Math.floor((((iranTotalMinutes % 1440) + 1440) % 1440) / 60);
            isNight = iranHour >= 18 || iranHour < 6;
          }

          if (isNight) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {
          console.error('Theme detection error:', e);
        }
      })();
    </script>
  </head>
  <body class="bg-white dark:bg-black text-neutral-900 dark:text-neutral-100 font-sans selection:bg-apple-blue/20 selection:text-apple-blue antialiased flex flex-col min-h-screen">
    <!-- Header with Sticky Frosted Glass & Reading Progress Bar -->
    <Header currentPath={currentPath} />

    <!-- Main Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Scroll To Top FAB (Appears 150px from Footer) -->
    <ScrollToTop />

    <!-- Client-side Animation Initializer -->
    <script>
      import { initScrollAnimations } from '../scripts/animations';
      initScrollAnimations();
    </script>
  </body>
</html>
