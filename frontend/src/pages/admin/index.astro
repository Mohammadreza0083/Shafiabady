---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { viewsApi } from '../../utils/api';
import type { ViewStatsDto } from '../../types';

// Extract HttpOnly session cookie for authenticated SSR requests
const token = Astro.cookies.get('AdminAuthToken')?.value;
if (!token) {
  return Astro.redirect('/admin/login');
}

// Fetch real aggregated engagement statistics from the backend
let stats: ViewStatsDto = {
  totalViews: 0,
  totalArticlesViews: 0,
  totalBooksViews: 0,
  totalCoursesViews: 0,
  topArticleTitle: 'در حال حاضر مقاله‌ای ثبت نشده است',
  topArticleViews: 0,
  topBookTitle: 'در حال حاضر کتابی ثبت نشده است',
  topBookViews: 0,
  topCourseTitle: 'در حال حاضر دوره‌ای ثبت نشده است',
  topCourseViews: 0,
  pendingCommentsCount: 0,
};

let fetchError: string | null = null;

try {
  const statsRes = await viewsApi.getStats(token);
  if (statsRes.isSuccess && statsRes.data) {
    stats = statsRes.data;
  } else if (statsRes.statusCode === 401) {
    return Astro.redirect('/admin/login');
  } else {
    fetchError = statsRes.errorMessage;
  }
} catch (e: any) {
  fetchError = e?.message || 'خطای اتصال به سرور';
}
---

<AdminLayout title="داشبورد و آمار سیستم" activeSection="dashboard">
  <div class="max-w-7xl mx-auto space-y-8">
    
    <!-- Welcome Banner -->
    <div class="relative overflow-hidden rounded-3xl p-8 bg-gradient-to-r from-apple-blue via-blue-600 to-indigo-700 text-white shadow-xl shadow-apple-blue/20">
      <div class="relative z-10 max-w-2xl">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-white/20 backdrop-blur-md mb-3">
          خوش آمدید، استاد
        </span>
        <h1 class="text-2xl sm:text-3xl font-black mb-2">
          داشبورد مدیریت پلتفرم آموزشی دکتر شفیع‌آبادی
        </h1>
        <p class="text-sm text-blue-100 leading-relaxed">
          گزارش زنده و لحظه‌ای بازدیدها، وضعیت محتوا و نظرات نیازمند بازبینی متصل به دیتابیس دات‌نت ۹.
        </p>
      </div>
      <!-- Background decorative circle -->
      <div class="absolute -left-10 -bottom-10 w-60 h-60 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
    </div>

    {fetchError && (
      <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-700 dark:text-amber-400 text-xs">
        {fetchError}
      </div>
    )}

    <!-- Stat Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      
      <!-- Card 1: Total Views -->
      <div class="p-6 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-bold text-neutral-500 dark:text-neutral-400">مجموع کل بازدیدها</span>
          <div class="w-10 h-10 rounded-2xl bg-blue-500/10 text-apple-blue dark:text-apple-blue-dark flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
        </div>
        <div>
          <div class="text-3xl font-black text-neutral-950 dark:text-white tracking-tight mb-1">
            {stats.totalViews.toLocaleString('fa-IR')}
          </div>
          <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">
            مجموع تعاملات زنده
          </span>
        </div>
      </div>

      <!-- Card 2: Top Article -->
      <div class="p-6 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-bold text-neutral-500 dark:text-neutral-400">مقاله برتر</span>
          <div class="w-10 h-10 rounded-2xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
          </div>
        </div>
        <div>
          <div class="text-sm font-bold text-neutral-950 dark:text-white line-clamp-1 mb-1" title={stats.topArticleTitle}>
            {stats.topArticleTitle}
          </div>
          <span class="text-xs font-medium text-neutral-400">
            {stats.topArticleViews.toLocaleString('fa-IR')} بازدید
          </span>
        </div>
      </div>

      <!-- Card 3: Top Book -->
      <div class="p-6 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-bold text-neutral-500 dark:text-neutral-400">کتاب پربازدید</span>
          <div class="w-10 h-10 rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
        </div>
        <div>
          <div class="text-sm font-bold text-neutral-950 dark:text-white line-clamp-1 mb-1" title={stats.topBookTitle}>
            {stats.topBookTitle}
          </div>
          <span class="text-xs font-medium text-neutral-400">
            {stats.topBookViews.toLocaleString('fa-IR')} بازدید
          </span>
        </div>
      </div>

      <!-- Card 4: Top Course -->
      <div class="p-6 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-bold text-neutral-500 dark:text-neutral-400">دوره برتر</span>
          <div class="w-10 h-10 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0020 6.818V4.182a1 1 0 00-.553-.894L15 1m0 9v13m0-13L3.447 4.182A1 1 0 003 5.076v13.848a1 1 0 001.447.894L15 14.273" />
            </svg>
          </div>
        </div>
        <div>
          <div class="text-sm font-bold text-neutral-950 dark:text-white line-clamp-1 mb-1" title={stats.topCourseTitle}>
            {stats.topCourseTitle}
          </div>
          <span class="text-xs font-medium text-neutral-400">
            {stats.topCourseViews.toLocaleString('fa-IR')} بازدید
          </span>
        </div>
      </div>

    </div>

    <!-- Quick Actions & Moderation Alerts -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Quick Actions (2 Cols) -->
      <div class="lg:col-span-2 p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm">
        <h2 class="text-base font-bold text-neutral-900 dark:text-white mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-apple-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>اقدامات سریع</span>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a
            href="/admin/articles/new"
            class="p-5 rounded-2xl bg-neutral-50 dark:bg-neutral-800/60 hover:bg-apple-blue hover:text-white dark:hover:bg-apple-blue group transition-all duration-200 flex flex-col justify-between"
          >
            <div class="w-10 h-10 rounded-xl bg-apple-blue/10 text-apple-blue group-hover:bg-white/20 group-hover:text-white flex items-center justify-center mb-4 transition-colors">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
            </div>
            <div>
              <span class="text-sm font-bold block mb-1">نگارش مقاله جدید</span>
              <span class="text-xs text-neutral-500 dark:text-neutral-400 group-hover:text-blue-100">با ویرایشگر استاندارد TinyMCE</span>
            </div>
          </a>

          <a
            href="/admin/books"
            class="p-5 rounded-2xl bg-neutral-50 dark:bg-neutral-800/60 hover:bg-apple-blue hover:text-white dark:hover:bg-apple-blue group transition-all duration-200 flex flex-col justify-between"
          >
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 group-hover:bg-white/20 group-hover:text-white flex items-center justify-center mb-4 transition-colors">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <div>
              <span class="text-sm font-bold block mb-1">مدیریت کتاب‌ها</span>
              <span class="text-xs text-neutral-500 dark:text-neutral-400 group-hover:text-blue-100">مشاهده و ویرایش کتاب‌ها</span>
            </div>
          </a>

          <a
            href="/admin/courses"
            class="p-5 rounded-2xl bg-neutral-50 dark:bg-neutral-800/60 hover:bg-apple-blue hover:text-white dark:hover:bg-apple-blue group transition-all duration-200 flex flex-col justify-between"
          >
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 group-hover:bg-white/20 group-hover:text-white flex items-center justify-center mb-4 transition-colors">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0020 6.818V4.182a1 1 0 00-.553-.894L15 1m0 9v13m0-13L3.447 4.182A1 1 0 003 5.076v13.848a1 1 0 001.447.894L15 14.273" />
              </svg>
            </div>
            <div>
              <span class="text-sm font-bold block mb-1">مدیریت دوره‌ها</span>
              <span class="text-xs text-neutral-500 dark:text-neutral-400 group-hover:text-blue-100">تنظیم سرفصل‌ها و جلسات</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Pending Moderation Widget (1 Col) -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-bold text-neutral-900 dark:text-white">نظرات در انتظار بررسی</h2>
            <span class={`px-2.5 py-0.5 rounded-full text-xs font-bold ${stats.pendingCommentsCount > 0 ? 'bg-rose-500/10 text-rose-600 dark:text-rose-400' : 'bg-emerald-500/10 text-emerald-600'}`}>
              {stats.pendingCommentsCount.toLocaleString('fa-IR')} نظر جدید
            </span>
          </div>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mb-6 leading-relaxed">
            {stats.pendingCommentsCount > 0
              ? 'دیدگاه‌های جدیدی برای محتوا ثبت شده که منتظر تأیید و انتشار عمومی شماست.'
              : 'در حال حاضر هیچ دیدگاه در انتظار تأییدی وجود ندارد.'}
          </p>
        </div>

        <a
          href="/admin/comments"
          class="w-full py-3 rounded-2xl bg-black/5 dark:bg-white/5 hover:bg-apple-blue hover:text-white dark:hover:bg-apple-blue text-xs font-bold text-center transition-all duration-200 block"
        >
          ورود به بخش مدیریت نظرات
        </a>
      </div>

    </div>

  </div>
</AdminLayout>
