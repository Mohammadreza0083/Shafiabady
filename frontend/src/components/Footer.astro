---
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-black/5 dark:border-white/10 bg-apple-surface dark:bg-neutral-950 transition-colors duration-300 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Bio -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-apple-blue dark:bg-apple-blue-dark flex items-center justify-center text-white font-bold text-base">
            ش
          </div>
          <span class="font-bold text-lg text-neutral-900 dark:text-white">
            دکتر محمد حسین شفیع‌آبادی
          </span>
        </div>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-md">
          پلتفرم شخصی اشتراک دانش مهندسی نرم‌افزار، معماری‌های پیشرفته کلین و سیستم‌های مقیاس‌پذیر در اکوسیستم دات‌نت، وب مدرن و هوش مصنوعی.
        </p>
      </div>

      <!-- Col 2: Fast Links -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-4">
          بخش‌های وب‌سایت
        </h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/articles" class="text-neutral-600 dark:text-neutral-400 hover:text-apple-blue dark:hover:text-apple-blue-dark transition-colors">
              مقالات تخصصی
            </a>
          </li>
          <li>
            <a href="/books" class="text-neutral-600 dark:text-neutral-400 hover:text-apple-blue dark:hover:text-apple-blue-dark transition-colors">
              کتاب‌ها و تألیفات
            </a>
          </li>
          <li>
            <a href="/courses" class="text-neutral-600 dark:text-neutral-400 hover:text-apple-blue dark:hover:text-apple-blue-dark transition-colors">
              دوره‌های آموزشی
            </a>
          </li>
          <li>
            <a href="/about" class="text-neutral-600 dark:text-neutral-400 hover:text-apple-blue dark:hover:text-apple-blue-dark transition-colors">
              درباره من و رزومه
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Contact & Telegram -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-4">
          ارتباط و شبکه‌ها
        </h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/contact" class="text-neutral-600 dark:text-neutral-400 hover:text-apple-blue dark:hover:text-apple-blue-dark transition-colors">
              فرم تماس مستقیم
            </a>
          </li>
          <li>
            <a href="https://t.me" target="_blank" rel="noopener noreferrer" class="text-neutral-600 dark:text-neutral-400 hover:text-apple-blue dark:hover:text-apple-blue-dark transition-colors flex items-center gap-1.5">
              <span>کانال تلگرام</span>
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.62 3.72-.53.36-1.01.54-1.44.53-.47-.01-1.38-.27-2.05-.49-.83-.27-1.49-.42-1.43-.88.03-.24.38-.49 1.03-.75 4.04-1.76 6.74-2.92 8.09-3.5 3.85-1.6 4.65-1.88 5.17-1.89.11 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.2-.04.38z"/>
              </svg>
            </a>
          </li>
          <li>
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-neutral-600 dark:text-neutral-400 hover:text-apple-blue dark:hover:text-apple-blue-dark transition-colors flex items-center gap-1.5">
              <span>گیت‌هاب</span>
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright & Disclaimer -->
    <div class="pt-8 border-t border-black/5 dark:border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500 dark:text-neutral-400">
      <p>© {currentYear} دکتر محمد حسین شفیع‌آبادی. تمامی حقوق محفوظ است.</p>
      <div class="flex items-center gap-4">
        <a href="https://www.linkedin.com/in/mohammadreza-bonyadi/" target="_blank" rel="noopener noreferrer" class="hover:text-blue-500 transition-colors duration-200">طراحی و اجرا توسط محمدرضا بنیادی</a>
        <span>•</span>
        <span class="text-apple-blue dark:text-apple-blue-dark">نسخه ۱.۰.۰</span>
      </div>
    </div>
  </div>
</footer>
