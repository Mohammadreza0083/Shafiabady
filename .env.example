# ==============================================================================
# ShafieiAbadi Platform Production Environment Variables Template
# Copy this file to .env and replace placeholders with secure, randomly generated values.
# NEVER commit the active .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration (SQL Server 2022)
# Password must be at least 8 characters and contain characters from 3 categories:
# Uppercase, Lowercase, Base 10 digits, Non-alphanumeric symbols.
# ------------------------------------------------------------------------------
SA_PASSWORD=ChangeMe_StrongComplexPassword_2026!
DATABASE_CONNECTION_STRING=Server=sqlserver,1433;Database=ShafieiAbadiDb;User Id=sa;Password=ChangeMe_StrongComplexPassword_2026!;TrustServerCertificate=True;MultipleActiveResultSets=true;

# ------------------------------------------------------------------------------
# JWT Authentication
# Generate a cryptographically secure 256-bit string (e.g. openssl rand -base64 48)
# ------------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_A_SECURE_256BIT_SECRET_STRING_AT_LEAST_64_CHARS_LONG
JWT_SECRET_KEY=REPLACE_WITH_A_SECURE_256BIT_SECRET_STRING_AT_LEAST_64_CHARS_LONG
JWT_ISSUER=ShafieiAbadi.Api
JWT_AUDIENCE=ShafieiAbadi.Client

# ------------------------------------------------------------------------------
# Telegram Bot & Alert Daemon
# Obtain token from @BotFather, and your Chat ID via @userinfobot
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_NUMERIC_CHAT_ID
TELEGRAM_ADMIN_CHAT_ID=YOUR_TELEGRAM_NUMERIC_ADMIN_CHAT_ID

# ------------------------------------------------------------------------------
# Public & Internal Endpoints
# ------------------------------------------------------------------------------
PUBLIC_API_URL=https://shafieiabadi.ir
INTERNAL_API_URL=http://backend:5000/api
SSR_API_URL=http://backend:5000/api

# ------------------------------------------------------------------------------
# Grafana Observability Dashboard
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMe_GrafanaSecurePassword_2026!
