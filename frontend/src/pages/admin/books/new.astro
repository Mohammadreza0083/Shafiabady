---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { categoriesApi } from '../../../utils/api';
import type { CategoryDto } from '../../../types';

const token = Astro.cookies.get('AdminAuthToken')?.value;
if (!token) {
  return Astro.redirect('/admin/login');
}

let categories: CategoryDto[] = [];
try {
  const catRes = await categoriesApi.getAll();
  if (catRes.isSuccess && catRes.data) {
    categories = catRes.data;
  }
} catch (e) {}
---

<AdminLayout title="ثبت و ویرایش کتاب جدید" activeSection="books">
  <div class="max-w-5xl mx-auto space-y-6">
    
    <!-- Page Header -->
    <div class="flex items-center justify-between pb-4 border-b border-black/5 dark:border-white/10">
      <div>
        <h1 class="text-2xl font-black text-neutral-950 dark:text-white">
          ثبت کتاب و اثر تألیفی جدید
        </h1>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
          اطلاعات مشخصات کتاب، پیوندهای خرید فیزیکی، دانلود نسخه دیجیتال و سرفصل‌ها
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/books"
          class="px-4 py-2 rounded-full border border-black/10 dark:border-white/10 text-xs font-semibold text-neutral-700 dark:text-neutral-300 hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
        >
          انصراف
        </a>
        <button
          type="button"
          id="btn-save-book"
          class="px-5 py-2 rounded-full bg-apple-blue hover:bg-blue-600 text-white text-xs font-bold shadow-md shadow-apple-blue/25 transition-all duration-200"
        >
          ثبت و انتشار کتاب
        </button>
      </div>
    </div>

    <!-- Book Form -->
    <form id="book-form" class="space-y-6">
      
      <!-- General Metadata Card -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm space-y-5">
        <h2 class="text-sm font-bold text-neutral-900 dark:text-white border-b border-black/5 dark:border-white/10 pb-3">
          مشخصات اصلی و شناسنامه کتاب
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label for="title" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              عنوان کتاب <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="title"
              name="title"
              required
              placeholder="مثال: معماری تمیز در عمل: راهنمای گام‌به‌گام دات‌نت"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>

          <div>
            <label for="slug" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              نامک آدرس (Slug) <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="slug"
              name="slug"
              required
              dir="ltr"
              placeholder="hands-on-clean-architecture-dotnet"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>
        </div>

        <div>
          <label for="subtitle" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
            عنوان فرعی یا توضیحات تکمیلی
          </label>
          <input
            type="text"
            id="subtitle"
            name="subtitle"
            placeholder="پیاده‌سازی Enterprise با رویکرد Domain-Driven Design و TDD"
            class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          <div>
            <label for="category" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              دسته‌بندی موضوعی
            </label>
            <select
              id="category"
              name="category"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            >
              {
                categories.map((cat) => (
                  <option value={cat.id}>{cat.title}</option>
                ))
              }
              {categories.length === 0 && (
                <>
                  <option value="">معماری نرم‌افزار</option>
                  <option value="">طراحی سیستم</option>
                </>
              )}
            </select>
          </div>

          <div>
            <label for="publisher" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              نام انتشارات / ناشر <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="publisher"
              name="publisher"
              required
              placeholder="مثال: انتشارات دیباگران"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>

          <div>
            <label for="publishedYear" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              سال چاپ / نوبت ویرایش
            </label>
            <input
              type="text"
              id="publishedYear"
              name="publishedYear"
              value="۱۴۰۳"
              placeholder="۱۴۰۳ (ویرایش دوم)"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>

          <div>
            <label for="pagesCount" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              تعداد صفحات
            </label>
            <input
              type="number"
              id="pagesCount"
              name="pagesCount"
              value="400"
              placeholder="مثال: ۴۵۰"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>
        </div>

        <div>
          <label for="coverImageUrl" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
            تصویر شاخص و طرح جلد (Cover Image URL)
          </label>
          <input
            type="url"
            id="coverImageUrl"
            name="coverImageUrl"
            dir="ltr"
            placeholder="https://images.unsplash.com/photo-..."
            class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
          />
        </div>
      </div>

      <!-- Book Links -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm space-y-5">
        <h2 class="text-sm font-bold text-neutral-900 dark:text-white border-b border-black/5 dark:border-white/10 pb-3">
          پیوندهای تهیه کتاب
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label for="buyLink" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              لینک خرید نسخه چاپی
            </label>
            <input
              type="url"
              id="buyLink"
              name="buyLink"
              dir="ltr"
              placeholder="https://publisher-store.ir/book/..."
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>

          <div>
            <label for="downloadLink" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              لینک دانلود نسخه الکترونیک
            </label>
            <input
              type="url"
              id="downloadLink"
              name="downloadLink"
              dir="ltr"
              placeholder="https://dl.shafieiabadi.ir/books/..."
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>
        </div>
      </div>

      <!-- Description -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm space-y-4">
        <h2 class="text-sm font-bold text-neutral-900 dark:text-white border-b border-black/5 dark:border-white/10 pb-3">
          معرفی و سرفصل‌های کتاب
        </h2>

        <div>
          <label for="description" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
            شرح کامل و مقدمه کتاب <span class="text-rose-500">*</span>
          </label>
          <textarea
            id="description"
            name="description"
            rows="5"
            required
            placeholder="معرفی جامع اهداف نگارش کتاب، سرفصل‌ها و مخاطبان هدف..."
            class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
          ></textarea>
        </div>
      </div>

    </form>
  </div>
</AdminLayout>

<script>
  import { booksApi } from '../../../utils/api';
  import { showToast, showAlert } from '../../../utils/ui-dialog';

  const saveBtn = document.getElementById('btn-save-book');

  saveBtn?.addEventListener('click', async () => {
    const title = (document.getElementById('title') as HTMLInputElement)?.value.trim();
    const slug = (document.getElementById('slug') as HTMLInputElement)?.value.trim();
    const subtitle = (document.getElementById('subtitle') as HTMLInputElement)?.value.trim();
    const publisher = (document.getElementById('publisher') as HTMLInputElement)?.value.trim();
    const publishedYear = (document.getElementById('publishedYear') as HTMLInputElement)?.value.trim() || '۱۴۰۳';
    const pagesCount = parseInt((document.getElementById('pagesCount') as HTMLInputElement)?.value || '300', 10);
    const coverImageUrl = (document.getElementById('coverImageUrl') as HTMLInputElement)?.value.trim() || 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=600&q=80';
    const buyLink = (document.getElementById('buyLink') as HTMLInputElement)?.value.trim();
    const downloadLink = (document.getElementById('downloadLink') as HTMLInputElement)?.value.trim();
    const description = (document.getElementById('description') as HTMLTextAreaElement)?.value.trim();
    const categorySelect = document.getElementById('category') as HTMLSelectElement;

    if (!title || !slug || !publisher || !description) {
      showToast('لطفاً فیلدهای ستاره‌دار (عنوان، نامک، ناشر و شرح کتاب) را تکمیل فرمایید.', 'warning');
      return;
    }

    try {
      if (saveBtn) saveBtn.textContent = 'در حال ثبت کتاب...';
      const result = await booksApi.create({
        title,
        slug,
        subtitle: subtitle || null,
        publisher,
        publishedYear,
        pagesCount,
        coverImageUrl,
        buyLink: buyLink || null,
        downloadLink: downloadLink || null,
        description,
        categoryId: categorySelect?.value ? categorySelect.value : null,
      });

      if (result.isSuccess) {
        await showAlert({
          title: 'ثبت موفقیت‌آمیز',
          message: 'کتاب جدید با موفقیت در سیستم ثبت و ذخیره گردید.',
          type: 'success',
        });
        window.location.href = '/admin/books';
      } else {
        showAlert({
          title: 'خطا در ثبت کتاب',
          message: result.errorMessage || 'خطا در ثبت کتاب',
          type: 'error',
        });
        if (saveBtn) saveBtn.textContent = 'ثبت و انتشار کتاب';
      }
    } catch (e: any) {
      showToast('خطا در ارتباط با سرور', 'error');
      if (saveBtn) saveBtn.textContent = 'ثبت و انتشار کتاب';
    }
  });
</script>
