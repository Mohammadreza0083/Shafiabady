---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="تعریف و ویرایش دوره آموزشی" activeSection="courses">
  <div class="max-w-5xl mx-auto space-y-6">
    
    <!-- Page Header -->
    <div class="flex items-center justify-between pb-4 border-b border-black/5 dark:border-white/10">
      <div>
        <h1 class="text-2xl font-black text-neutral-950 dark:text-white">
          تعریف دوره آموزشی جدید
        </h1>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
          تنظیم مشخصات دوره، لینک ویدیوی آپارات، قیمت‌گذاری و سرفصل‌های تدریس
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/courses"
          class="px-4 py-2 rounded-full border border-black/10 dark:border-white/10 text-xs font-semibold text-neutral-700 dark:text-neutral-300 hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
        >
          انصراف
        </a>
        <button
          type="button"
          id="btn-save-course"
          class="px-5 py-2 rounded-full bg-apple-blue hover:bg-blue-600 text-white text-xs font-bold shadow-md shadow-apple-blue/25 transition-all duration-200"
        >
          ثبت و انتشار دوره
        </button>
      </div>
    </div>

    <!-- Course Form -->
    <form id="course-form" class="space-y-6">
      
      <!-- General Metadata Card -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm space-y-5">
        <h2 class="text-sm font-bold text-neutral-900 dark:text-white border-b border-black/5 dark:border-white/10 pb-3">
          اطلاعات اصلی دوره
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label for="title" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              عنوان دوره آموزشی <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="title"
              name="title"
              required
              placeholder="مثال: مسترکلاس پیشرفته Clean Architecture در .NET 9"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>

          <div>
            <label for="slug" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              نامک آدرس (Slug) <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="slug"
              name="slug"
              required
              dir="ltr"
              placeholder="mastering-clean-architecture-dotnet-9"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>
        </div>

        <!-- Universal Fields: Thumbnail & Category -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          <div>
            <label for="category" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              دسته‌بندی موضوعی <span class="text-rose-500">*</span>
            </label>
            <select
              id="category"
              name="category"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            >
              <option value="معماری نرم‌افزار">معماری نرم‌افزار</option>
              <option value="میکروسرویس و سیستم‌های توزیع‌شده">میکروسرویس و توزیع‌شده</option>
              <option value="برنامه‌نویسی پیشرفته C#">برنامه‌نویسی پیشرفته C#</option>
              <option value="طراحی وب و فرانت‌اند مدرن">طراحی وب و فرانت‌اند</option>
              <option value="کیفیت کد و تست">کیفیت کد و تست</option>
            </select>
          </div>

          <div>
            <label for="level" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              سطح دوره
            </label>
            <select
              id="level"
              name="level"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            >
              <option value="پیشرفته">پیشرفته (Enterprise)</option>
              <option value="متوسط تا پیشرفته">متوسط تا پیشرفته</option>
              <option value="مقدماتی تا متوسط">مقدماتی تا متوسط</option>
              <option value="جامع (صفر تا صد)">جامع (صفر تا صد)</option>
            </select>
          </div>

          <div>
            <label for="duration" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              مدت زمان کل
            </label>
            <input
              type="text"
              id="duration"
              name="duration"
              placeholder="۴۲ ساعت و ۳۰ دقیقه"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>

          <div>
            <label for="lessonsCount" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              تعداد جلسات
            </label>
            <input
              type="number"
              id="lessonsCount"
              name="lessonsCount"
              placeholder="مثال: ۳۸"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>
        </div>

        <div>
          <label for="thumbnail" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
            تصویر شاخص دوره (Thumbnail Image URL) <span class="text-rose-500">*</span>
          </label>
          <input
            type="url"
            id="thumbnail"
            name="thumbnail"
            dir="ltr"
            placeholder="https://images.unsplash.com/photo-..."
            class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
          />
        </div>
      </div>

      <!-- Course-Specific Field: Aparat Video Embed URL -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm space-y-5">
        <div class="flex items-center gap-2 border-b border-black/5 dark:border-white/10 pb-3">
          <div class="w-7 h-7 rounded-lg bg-rose-500/10 text-rose-500 flex items-center justify-center font-bold text-xs">
            ▶
          </div>
          <h2 class="text-sm font-bold text-neutral-900 dark:text-white">
            ویدیوی معرفی دوره در آپارات (Aparat Video Embed URL)
          </h2>
        </div>

        <div>
          <label for="aparatVideoUrl" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
            لینک ویدیو یا کد امبد آپارات (Aparat Video Embed URL)
          </label>
          <input
            type="url"
            id="aparatVideoUrl"
            name="aparatVideoUrl"
            dir="ltr"
            placeholder="https://www.aparat.com/video/video/embed/videohash/..."
            class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
          />
          <span class="text-[11px] text-neutral-400 mt-1.5 block leading-relaxed">
            لینک آی‌فریم یا شناسه ویدیوی معرفی رایگان آپارات جهت نمایش تیزر و جلسه اول دوره در صفحه اختصاصی
          </span>
        </div>
      </div>

      <!-- Pricing & Discounts -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm space-y-5">
        <h2 class="text-sm font-bold text-neutral-900 dark:text-white border-b border-black/5 dark:border-white/10 pb-3">
          شهریه و تخفیف‌های دوره
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          <div>
            <label for="price" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              مبلغ پرداختی نهایی (تومان)
            </label>
            <input
              type="number"
              id="price"
              name="price"
              placeholder="مثال: ۳۵۰۰۰۰۰"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>

          <div>
            <label for="originalPrice" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              قیمت اصلی قبل از تخفیف (تومان)
            </label>
            <input
              type="number"
              id="originalPrice"
              name="originalPrice"
              placeholder="مثال: ۵۰۰۰۰۰۰"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>

          <div>
            <label for="discountPercentage" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              درصد تخفیف ویژه (Badge)
            </label>
            <input
              type="number"
              id="discountPercentage"
              name="discountPercentage"
              placeholder="مثال: ۳۰"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>
        </div>
      </div>

      <!-- Description & Syllabus -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm space-y-4">
        <h2 class="text-sm font-bold text-neutral-900 dark:text-white border-b border-black/5 dark:border-white/10 pb-3">
          توضیحات و سرفصل‌های دوره
        </h2>

        <div>
          <label for="description" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
            شرح جامع دوره و پیش‌نیازها <span class="text-rose-500">*</span>
          </label>
          <textarea
            id="description"
            name="description"
            rows="5"
            required
            placeholder="معرفی اهداف دوره، مهارت‌های اکتسابی دانشجویان، پروژه‌های عملی..."
            class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
          ></textarea>
        </div>
      </div>

    </form>
  </div>
</AdminLayout>

<script>
  document.getElementById('btn-save-course')?.addEventListener('click', () => {
    const titleInput = document.getElementById('title') as HTMLInputElement;
    if (!titleInput?.value.trim()) {
      alert('لطفاً عنوان دوره را وارد نمایید.');
      titleInput?.focus();
      return;
    }

    alert('اطلاعات دوره آموزشی (شامل لینک ویدیوی آپارات و تخفیف‌ها) با موفقیت ثبت شد.');
    window.location.href = '/admin/courses';
  });
</script>
