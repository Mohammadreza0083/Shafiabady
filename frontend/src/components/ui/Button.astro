---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'glass';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  className?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  className = '',
} = Astro.props;

const sizeStyles = {
  sm: 'px-4 py-1.5 text-xs',
  md: 'px-6 py-2.5 text-sm',
  lg: 'px-8 py-3.5 text-base font-semibold',
};

const variantStyles = {
  primary: 'bg-apple-blue hover:bg-apple-blue-hover text-white shadow-md shadow-apple-blue/25 hover:shadow-apple-blue/40 dark:bg-apple-blue-dark dark:hover:bg-sky-400',
  secondary: 'bg-black/5 hover:bg-black/10 text-neutral-800 dark:bg-white/10 dark:hover:bg-white/15 dark:text-neutral-100 border border-black/5 dark:border-white/10',
  ghost: 'bg-transparent hover:bg-black/5 text-neutral-700 dark:text-neutral-300 dark:hover:bg-white/10',
  glass: 'apple-glass text-neutral-900 dark:text-white hover:bg-white/90 dark:hover:bg-black/90 shadow-sm',
};

const baseStyles = 'inline-flex items-center justify-center gap-2 rounded-full font-medium transition-all duration-300 transform active:scale-95 focus:outline-none focus:ring-2 focus:ring-apple-blue/50';
const combinedClass = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={combinedClass}>
      <slot />
    </a>
  ) : (
    <button type={type} class={combinedClass}>
      <slot />
    </button>
  )
}
