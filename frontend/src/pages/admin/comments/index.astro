---
import AdminLayout from '../../../layouts/AdminLayout.astro';

// Mock Pending Comments Data for Admin Moderation
const pendingComments = [
  {
    id: 'c1',
    authorName: 'سید رضا حسینی',
    authorEmail: 'reza.hosseini@gmail.com',
    entityType: 'مقاله',
    entityTitle: 'راهنمای جامع معماری تمیز در دات‌نت ۹',
    entitySlug: '/articles/clean-architecture-dotnet-9',
    content: 'استاد گرامی، بابت آموزش فوق‌العاده سپاسگزارم. در خصوص جداسازی لایه Infrastructure و تفکیک Core، پیشنهاد شما برای رجیستر کردن Dependency Injection در پروژه‌های ماژولار چیست؟',
    createdAt: '۱۴۰۳/۰۶/۰۱ - ۱۱:۳۰',
    status: 'pending',
  },
  {
    id: 'c2',
    authorName: 'مهندس مریم کاظمی',
    authorEmail: 'm.kazemi@outlook.com',
    entityType: 'دوره',
    entityTitle: 'دوره جامع مسترکلاس Clean Architecture در .NET 9',
    entitySlug: '/courses/mastering-clean-architecture-dotnet-9',
    content: 'سلام وقت بخیر، آیا سرفصل‌های مربوط به Event Sourcing و Masstransit در آپدیت بعدی این دوره اضافه خواهند شد؟',
    createdAt: '۱۴۰۳/۰۶/۰۱ - ۱۰:۱۵',
    status: 'pending',
  },
  {
    id: 'c3',
    authorName: 'علیرضا نوری',
    authorEmail: 'alireza.nouri@yahoo.com',
    entityType: 'کتاب',
    entityTitle: 'معماری تمیز در عمل',
    entitySlug: '/books/hands-on-clean-architecture-dotnet',
    content: 'کتاب بسیار روان و جامعی است. به همه برنامه‌نویسان ارشد دات‌نت توصیه می‌کنم حتماً فصل ۳ و ۴ رو مطالعه کنند.',
    createdAt: '۱۴۰۳/۰۵/۳۰ - ۱۸:۴۵',
    status: 'pending',
  },
];
---

<AdminLayout title="مدیریت و تأیید نظرات کاربران" activeSection="comments">
  <div class="max-w-7xl mx-auto space-y-6">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-black/5 dark:border-white/10">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-black text-neutral-950 dark:text-white">
            مدیریت نظرات کاربران
          </h1>
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20">
            {pendingComments.length} نظر در انتظار تایید
          </span>
        </div>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
          بررسی دیدگاه‌های ارسالی مخاطبان، تایید یا رد قبل از نمایش عمومی در سایت
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-approve-all"
          class="px-4 py-2 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold shadow-sm transition-all duration-200"
        >
          تأیید همه نظرات
        </button>
      </div>
    </div>

    <!-- Comments Moderation Cards / Table -->
    <div class="space-y-4" id="comments-container">
      {
        pendingComments.map((comment) => (
          <div
            id={`comment-row-${comment.id}`}
            class="p-6 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm transition-all duration-300"
          >
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/20 dark:text-apple-blue-dark flex items-center justify-center font-bold text-sm">
                  {comment.authorName.charAt(0)}
                </div>
                <div>
                  <span class="font-bold text-sm text-neutral-900 dark:text-white block">
                    {comment.authorName}
                  </span>
                  <span class="text-[11px] text-neutral-400 font-mono">
                    {comment.authorEmail}
                  </span>
                </div>
              </div>

              <div class="flex items-center gap-2 text-xs">
                <span class="px-2.5 py-1 rounded-full bg-black/5 dark:bg-white/5 text-neutral-500 dark:text-neutral-400">
                  {comment.createdAt}
                </span>
                <span class="px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 font-semibold">
                  در انتظار بررسی
                </span>
              </div>
            </div>

            <!-- Comment Context -->
            <div class="mb-3 flex items-center gap-1.5 text-xs text-neutral-500 dark:text-neutral-400">
              <span>دیدگاه مربوط به {comment.entityType}:</span>
              <a href={comment.entitySlug} target="_blank" class="font-semibold text-apple-blue dark:text-apple-blue-dark hover:underline">
                {comment.entityTitle}
              </a>
            </div>

            <!-- Comment Body Text -->
            <p class="text-sm text-neutral-800 dark:text-neutral-200 leading-relaxed bg-neutral-50 dark:bg-neutral-800/60 p-4 rounded-2xl mb-5">
              {comment.content}
            </p>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-3 pt-3 border-t border-black/5 dark:border-white/5">
              <button
                type="button"
                class="reject-btn px-4 py-2 rounded-full border border-rose-500/30 text-rose-600 dark:text-rose-400 hover:bg-rose-500 hover:text-white text-xs font-semibold transition-all duration-200 flex items-center gap-1.5"
                data-id={comment.id}
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span>رد دیدگاه</span>
              </button>

              <button
                type="button"
                class="approve-btn px-5 py-2 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold shadow-sm transition-all duration-200 flex items-center gap-1.5"
                data-id={comment.id}
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>تأیید و انتشار عمومی</span>
              </button>
            </div>
          </div>
        ))
      }
    </div>

  </div>
</AdminLayout>

<script>
  document.querySelectorAll('.approve-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id');
      const row = document.getElementById(`comment-row-${id}`);
      if (row) {
        row.style.opacity = '0.5';
        row.innerHTML = `
          <div class="py-4 text-center text-emerald-600 dark:text-emerald-400 font-bold text-xs flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>دیدگاه با موفقیت تأیید شد و در سایت نمایش داده می‌شود.</span>
          </div>
        `;
      }
    });
  });

  document.querySelectorAll('.reject-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id');
      const row = document.getElementById(`comment-row-${id}`);
      if (row && confirm('آیا از رد و حذف این دیدگاه اطمینان دارید؟')) {
        row.style.opacity = '0.5';
        row.innerHTML = `
          <div class="py-4 text-center text-rose-500 font-bold text-xs">
            دیدگاه رد و بایگانی شد.
          </div>
        `;
      }
    });
  });

  document.getElementById('btn-approve-all')?.addEventListener('click', () => {
    alert('تمام دیدگاه‌های در انتظار بررسی تأیید شدند.');
    document.querySelectorAll('.approve-btn').forEach((b) => (b as HTMLElement).click());
  });
</script>
