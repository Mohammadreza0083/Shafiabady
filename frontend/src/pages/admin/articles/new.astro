---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import RichTextToolbar from '../../../components/RichTextToolbar.astro';
import { categoriesApi } from '../../../utils/api';
import type { CategoryDto } from '../../../types';

const token = Astro.cookies.get('AdminAuthToken')?.value;
if (!token) {
  return Astro.redirect('/admin/login');
}

let categories: CategoryDto[] = [];
try {
  const catRes = await categoriesApi.getAll();
  if (catRes.isSuccess && catRes.data) {
    categories = catRes.data;
  }
} catch (e) {}
---

<AdminLayout title="نگارش و انتشار مقاله جدید" activeSection="articles">
  <div class="max-w-5xl mx-auto space-y-6">
    
    <!-- Page Header -->
    <div class="flex items-center justify-between pb-4 border-b border-black/5 dark:border-white/10">
      <div>
        <h1 class="text-2xl font-black text-neutral-950 dark:text-white">
          نگارش مقاله جدید
        </h1>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
          محتوا و جزئیات سئو مقاله را وارد کرده و با ویرایشگر هوشمند متن آن را تدوین نمایید
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/articles"
          class="px-4 py-2 rounded-full border border-black/10 dark:border-white/10 text-xs font-semibold text-neutral-700 dark:text-neutral-300 hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
        >
          انصراف
        </a>
        <button
          type="button"
          id="btn-publish"
          class="px-5 py-2 rounded-full bg-apple-blue hover:bg-blue-600 text-white text-xs font-bold shadow-md shadow-apple-blue/25 transition-all duration-200"
        >
          انتشار مقاله
        </button>
      </div>
    </div>

    <!-- Article Editor Form -->
    <form id="article-form" class="space-y-6">
      
      <!-- General Metadata Card -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm space-y-5">
        <h2 class="text-sm font-bold text-neutral-900 dark:text-white border-b border-black/5 dark:border-white/10 pb-3">
          مشخصات اصلی و سئو
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label for="title" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              عنوان مقاله <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="title"
              name="title"
              required
              placeholder="مثال: راهنمای جامع معماری تمیز در دات‌نت ۹"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>

          <div>
            <label for="slug" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              نامک آدرس (Slug) <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="slug"
              name="slug"
              required
              dir="ltr"
              placeholder="clean-architecture-dotnet-9"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          <div>
            <label for="authorName" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              نام نویسنده <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="authorName"
              name="authorName"
              value="دکتر محمد حسین شفیع‌آبادی"
              required
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>

          <div>
            <label for="category" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              دسته‌بندی <span class="text-rose-500">*</span>
            </label>
            <select
              id="category"
              name="category"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            >
              {
                categories.map((cat) => (
                  <option value={cat.id}>{cat.title}</option>
                ))
              }
              {categories.length === 0 && (
                <>
                  <option value="">عمومی</option>
                  <option value="">معماری نرم‌افزار</option>
                  <option value="">طراحی سیستم</option>
                </>
              )}
            </select>
          </div>

          <div>
            <label for="readingTimeMinutes" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              مدت زمان مطالعه (دقیقه)
            </label>
            <input
              type="number"
              id="readingTimeMinutes"
              name="readingTimeMinutes"
              value="10"
              min="1"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>

          <div>
            <label for="tags" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              برچسب‌ها (با کاما)
            </label>
            <input
              type="text"
              id="tags"
              name="tags"
              placeholder="دات‌نت، Clean Architecture"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>
        </div>

        <div>
          <label for="thumbnailUrl" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
            آدرس تصویر کاور (Thumbnail URL)
          </label>
          <input
            type="url"
            id="thumbnailUrl"
            name="thumbnailUrl"
            dir="ltr"
            placeholder="https://images.unsplash.com/photo-..."
            class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
          />
        </div>

        <div>
          <label for="summary" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
            چکیده و خلاصه مقاله (توضیحات سئو) <span class="text-rose-500">*</span>
          </label>
          <textarea
            id="summary"
            name="summary"
            rows="2"
            required
            placeholder="خلاصه کوتاهی از موضوع و ارزش‌های کلیدی مقاله..."
            class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all resize-none"
          ></textarea>
        </div>
      </div>

      <!-- Rich Text Editor (WYSIWYG) Card -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-black/5 dark:border-white/10 pb-3">
          <div class="flex items-center gap-2">
            <h2 class="text-sm font-bold text-neutral-900 dark:text-white">
              محتوای اصلی مقاله (Rich Text Editor / Markdown)
            </h2>
          </div>
          <span class="text-[11px] text-neutral-400">
            پشتیبانی از فرمت‌های غنی، کد، جداول و تصاویر
          </span>
        </div>

        <RichTextToolbar />

        <!-- Editable WYSIWYG Content Area -->
        <div
          id="editor-content"
          contenteditable="true"
          class="min-h-[350px] p-5 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 focus:outline-none focus:ring-2 focus:ring-apple-blue prose dark:prose-invert max-w-none text-sm leading-relaxed"
        >
          <h2>مقدمه و اهداف این مقاله</h2>
          <p>در این بخش متن تخصصی خود را بنویسید. تمامی استایل‌ها، عناوین و بلوک‌های کد به صورت استاندارد ذخیره خواهند شد.</p>
        </div>
      </div>

    </form>
  </div>
</AdminLayout>

<script>
  import { articlesApi } from '../../../utils/api';
  import { showToast, showAlert } from '../../../utils/ui-dialog';
  import { enhanceImageUrlInput } from '../../../utils/image-upload';
  import { initRichEditor } from '../../../utils/rich-editor';

  enhanceImageUrlInput(document.getElementById('thumbnailUrl') as HTMLInputElement | null);

  const editor = document.getElementById('editor-content');
  const publishBtn = document.getElementById('btn-publish');

  initRichEditor(editor);

  publishBtn?.addEventListener('click', async () => {
    const titleInput = document.getElementById('title') as HTMLInputElement;
    const slugInput = document.getElementById('slug') as HTMLInputElement;
    const authorNameInput = document.getElementById('authorName') as HTMLInputElement;
    const categorySelect = document.getElementById('category') as HTMLSelectElement;
    const readingTimeInput = document.getElementById('readingTimeMinutes') as HTMLInputElement;
    const tagsInput = document.getElementById('tags') as HTMLInputElement;
    const thumbnailInput = document.getElementById('thumbnailUrl') as HTMLInputElement;
    const summaryInput = document.getElementById('summary') as HTMLTextAreaElement;

    if (!titleInput?.value.trim() || !slugInput?.value.trim() || !summaryInput?.value.trim()) {
      showToast('لطفاً عنوان، نامک آدرس و خلاصه مقاله را وارد نمایید.', 'warning');
      return;
    }

    const contentHtml = editor?.innerHTML || '';

    try {
      if (publishBtn) publishBtn.textContent = 'در حال ذخیره...';
      const result = await articlesApi.create({
        title: titleInput.value.trim(),
        slug: slugInput.value.trim(),
        authorName: authorNameInput.value.trim(),
        content: contentHtml,
        summary: summaryInput.value.trim(),
        thumbnailUrl: thumbnailInput?.value?.trim() || 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=800&q=80',
        readingTimeMinutes: parseInt(readingTimeInput?.value || '10', 10),
        categoryId: categorySelect?.value ? categorySelect.value : null,
      });

      if (result.isSuccess) {
        await showAlert({
          title: 'انتشار موفقیت‌آمیز',
          message: 'مقاله جدید با موفقیت ایجاد و منتشر گردید.',
          type: 'success',
        });
        window.location.href = '/admin/articles';
      } else {
        showAlert({
          title: 'خطا در ثبت مقاله',
          message: result.errorMessage || 'خطا در ثبت مقاله',
          type: 'error',
        });
        if (publishBtn) publishBtn.textContent = 'انتشار مقاله';
      }
    } catch (e: any) {
      showToast('خطا در برقراری ارتباط با سرور.', 'error');
      if (publishBtn) publishBtn.textContent = 'انتشار مقاله';
    }
  });
</script>
