---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCta from '../../components/ContactCta.astro';
import { expertiseTopics, type ExpertiseTopic } from '../../data/expertise';

export const prerender = true;

export function getStaticPaths() {
  return expertiseTopics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

interface Props {
  topic: ExpertiseTopic;
}

const { topic } = Astro.props;
const otherTopics = expertiseTopics.filter((t) => t.slug !== topic.slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': topic.title,
  'description': topic.shortText,
  'url': `https://shafieiabadi.ir/expertise/${topic.slug}`,
  'provider': {
    '@type': 'Person',
    'name': 'دکتر محمد حسین شفیع‌آبادی',
    'url': 'https://shafieiabadi.ir',
  },
};
---

<BaseLayout title={topic.title} description={topic.shortText} ogImage={topic.image.src} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10">
    <div class={`relative rounded-3xl sm:rounded-[2.5rem] border border-black/5 dark:border-white/10 overflow-hidden bg-gradient-to-br ${topic.gradient} bg-white/80 dark:bg-neutral-900/80 shadow-xl`}>
      <div class={`absolute -top-24 -left-24 w-96 h-96 ${topic.glowColor1} rounded-full blur-3xl pointer-events-none`}></div>
      <div class={`absolute -bottom-24 -right-24 w-96 h-96 ${topic.glowColor2} rounded-full blur-3xl pointer-events-none`}></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12">
        <div class="order-2 lg:order-1 lg:col-span-7 px-6 pb-10 pt-2 sm:px-12 lg:py-16 lg:pr-16 lg:pl-4 flex flex-col justify-center text-center lg:text-right items-center lg:items-start">
          <nav aria-label="مسیر صفحه" class="text-xs text-neutral-500 dark:text-neutral-400 mb-5 flex items-center gap-2">
            <a href="/" class="hover:text-apple-blue transition-colors">صفحه اصلی</a>
            <span>/</span>
            <span class="text-neutral-700 dark:text-neutral-300">{topic.tag}</span>
          </nav>
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/20 dark:text-apple-blue-dark mb-5 border border-apple-blue/15">
            <span class="w-2 h-2 rounded-full bg-apple-blue dark:bg-apple-blue-dark"></span>
            {topic.tag}
          </span>
          <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-neutral-950 dark:text-white leading-[1.25] mb-5">
            {topic.title}
          </h1>
          <p class="text-base sm:text-xl text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-2xl">
            {topic.shortText}
          </p>
        </div>
        <div class="order-1 lg:order-2 lg:col-span-5 flex items-end justify-center h-64 sm:h-80 lg:h-[480px] pt-8">
          <img
            src={topic.image.src}
            alt={topic.image.alt}
            width={topic.image.width}
            height={topic.image.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="h-full w-auto max-w-full object-contain object-bottom drop-shadow-2xl"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Long description + focus points -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
      <article class="lg:col-span-8 space-y-6">
        <span class="text-xs font-bold text-apple-blue dark:text-apple-blue-dark uppercase tracking-widest block">
          اطلاعات بیشتر
        </span>
        {topic.paragraphs.map((paragraph) => (
          <p class="text-base sm:text-lg text-neutral-700 dark:text-neutral-300 leading-loose text-justify">
            {paragraph}
          </p>
        ))}
      </article>

      <aside class="lg:col-span-4">
        <div class="apple-glass-card p-6 sm:p-8 rounded-3xl lg:sticky lg:top-24">
          <h2 class="text-lg font-bold text-neutral-900 dark:text-white mb-5">محورهای همکاری</h2>
          <ul class="space-y-4">
            {topic.focusPoints.map((point) => (
              <li class="flex items-start gap-3 text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
                <svg class="w-5 h-5 flex-shrink-0 text-apple-blue dark:text-apple-blue-dark mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <!-- Sample projects -->
  <section class="bg-apple-surface dark:bg-neutral-950/60 py-16 sm:py-20 border-y border-black/5 dark:border-white/5 mb-16 sm:mb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10">
        <span class="text-xs font-bold text-apple-blue dark:text-apple-blue-dark uppercase tracking-widest block mb-2">
          نمونه پروژه‌ها
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-neutral-950 dark:text-white tracking-tight">
          پروژه‌های انجام‌شده در این حوزه
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        {topic.projects.map((project, i) => (
          <div class="apple-card p-6 sm:p-8 rounded-3xl border border-black/5 dark:border-white/10 flex flex-col">
            <div class="flex items-center justify-between mb-5">
              <span class="w-11 h-11 rounded-2xl bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/20 dark:text-apple-blue-dark flex items-center justify-center font-black">
                {(i + 1).toLocaleString('fa-IR')}
              </span>
              <div class="flex flex-wrap gap-2 justify-end">
                {project.tags.map((tag) => (
                  <span class="text-[11px] font-semibold px-2.5 py-1 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300">{tag}</span>
                ))}
              </div>
            </div>
            <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-3">{project.title}</h3>
            <p class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed mb-5 flex-1">{project.summary}</p>
            <div class="pt-4 border-t border-black/5 dark:border-white/5 flex items-start gap-2 text-sm">
              <span class="font-bold text-emerald-600 dark:text-emerald-400 whitespace-nowrap">نتیجه:</span>
              <span class="text-neutral-600 dark:text-neutral-400">{project.outcome}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Other topics -->
      <div class="mt-14 flex flex-wrap items-center gap-3">
        <span class="text-sm font-bold text-neutral-500 dark:text-neutral-400 ml-2">حوزه‌های دیگر:</span>
        {otherTopics.map((t) => (
          <a href={`/expertise/${t.slug}`} class="px-4 py-2 rounded-full text-sm font-medium bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 text-neutral-700 dark:text-neutral-200 hover:text-apple-blue hover:border-apple-blue/30 transition-colors">
            {t.title}
          </a>
        ))}
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>
