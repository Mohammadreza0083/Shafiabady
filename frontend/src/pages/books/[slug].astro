---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import { booksApi } from '../../utils/api';
import { mockBooks } from '../../data/mockData';

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

let cleanSlug = slug;
try {
  cleanSlug = decodeURIComponent(slug);
} catch {}

let bookData: any = null;

try {
  let res = await booksApi.getBySlug(cleanSlug);
  if ((!res.isSuccess || !res.data) && slug !== cleanSlug) {
    res = await booksApi.getBySlug(slug);
  }
  if (res.isSuccess && res.data) {
    const raw = res.data;
    bookData = {
      id: raw.id,
      title: raw.title || 'بدون عنوان',
      slug: raw.slug || cleanSlug,
      subtitle: raw.subtitle || 'کتاب تخصصی در حوزه مهندسی نرم‌افزار',
      description: raw.description || '',
      publisher: raw.publisher || 'انتشارات دانش و فناوری',
      publishYear: raw.publishedYear || raw.publishYear || '۱۴۰۲',
      pagesCount: raw.pagesCount || 300,
      coverImage: raw.thumbnailUrl || '',
      viewsCount: raw.viewsCount || 0,
    };
  }
} catch (e) {
  // Fallback to mock data if backend is offline
}

if (!bookData) {
  const fallback = mockBooks.find((b) => b.slug === slug || b.slug === cleanSlug);
  if (fallback) {
    bookData = fallback;
  } else {
    return Astro.redirect('/404');
  }
}

const book = bookData;

const bookJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  'name': book.title,
  'headline': book.subtitle,
  'description': book.description,
  'author': {
    '@type': 'Person',
    'name': 'دکتر محمد حسین شفیع‌آبادی',
    'url': 'https://shafieiabadi.ir/about',
  },
  'publisher': {
    '@type': 'Organization',
    'name': book.publisher,
  },
  'datePublished': book.publishYear,
  'numberOfPages': book.pagesCount,
  'inLanguage': 'fa',
};
---

<BaseLayout
  title={book.title}
  description={book.description}
  pageType="book"
  ogImage={book.coverImage || undefined}
  jsonLd={bookJsonLd}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16" data-entity-id={book.id}>
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-neutral-400 dark:text-neutral-500 mb-8">
      <a href="/" class="hover:text-neutral-700 dark:hover:text-neutral-300">خانه</a>
      <span>/</span>
      <a href="/books" class="hover:text-neutral-700 dark:hover:text-neutral-300">کتاب‌ها</a>
      <span>/</span>
      <span class="text-neutral-600 dark:text-neutral-400 truncate max-w-[200px]">{book.title}</span>
    </nav>

    <!-- Book Detail Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start">
      <!-- Book Mockup Column -->
      <div class="md:col-span-5 flex flex-col items-center">
        <div class="relative w-64 h-96 rounded-2xl overflow-hidden shadow-2xl bg-neutral-900 border border-white/10 flex items-center justify-center mb-6">
          <div class="p-6 flex flex-col items-center justify-center text-white h-full w-full bg-gradient-to-br from-neutral-800 via-neutral-900 to-black text-center">
            <div class="w-14 h-14 rounded-2xl bg-apple-blue flex items-center justify-center text-white font-bold text-2xl mb-4 shadow-lg">
              ک
            </div>
            <h2 class="text-base font-bold leading-tight mb-2">{book.title}</h2>
            <p class="text-xs text-neutral-400 mb-4">{book.subtitle}</p>
            <span class="text-xs text-neutral-500">{book.publishYear}</span>
          </div>
        </div>

        <div class="w-full space-y-3">
          <Button href="/contact" variant="primary" size="lg" className="w-full">
            <span>تهیه نسخه چاپی / الکترونیک</span>
          </Button>
        </div>
      </div>

      <!-- Book Info Column -->
      <div class="md:col-span-7 space-y-6">
        <div>
          <span class="px-3 py-1 rounded-full text-xs font-semibold bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/20 dark:text-apple-blue-dark inline-block mb-3">
            تألیف و ویرایش تخصصی
          </span>
          <h1 class="text-2xl sm:text-4xl font-extrabold text-neutral-950 dark:text-white tracking-tight leading-tight mb-3">
            {book.title}
          </h1>
          <p class="text-base text-neutral-500 dark:text-neutral-400 font-medium">
            {book.subtitle}
          </p>
        </div>

        <!-- Metadata Spec Table -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 p-5 rounded-2xl bg-apple-surface dark:bg-neutral-900 border border-black/5 dark:border-white/10 text-sm">
          <div>
            <span class="block text-xs text-neutral-400 mb-1">ناشر:</span>
            <strong class="text-neutral-800 dark:text-neutral-200">{book.publisher}</strong>
          </div>
          <div>
            <span class="block text-xs text-neutral-400 mb-1">تعداد صفحات:</span>
            <strong class="text-neutral-800 dark:text-neutral-200">{book.pagesCount} صفحه</strong>
          </div>
          <div>
            <span class="block text-xs text-neutral-400 mb-1">سال انتشار:</span>
            <strong class="text-neutral-800 dark:text-neutral-200">{book.publishYear}</strong>
          </div>
          <div>
            <span class="block text-xs text-neutral-400 mb-1">بازدید:</span>
            <strong id="book-views-counter" class="text-neutral-800 dark:text-neutral-200">{book.viewsCount} بازدید</strong>
          </div>
        </div>

        <!-- Description -->
        <div class="space-y-4 text-neutral-700 dark:text-neutral-300 leading-relaxed text-sm sm:text-base">
          <h3 class="text-lg font-bold text-neutral-900 dark:text-white">درباره این اثر</h3>
          <p>{book.description}</p>
          <p>
            این اثر حاصل سال‌ها تجربه عملی در طراحی و پیاده‌سازی سیستم‌های در مقیاس بالا و آموزش به صدها مهندس نرم‌افزار است. با مطالعه این کتاب، دیدگاه شما از سطح کدنویسی مقدماتی به تفکر معمارانه و تصمیم‌گیری ساختاری ارتقا می‌یابد.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { trackView } from '../../scripts/view-counter';

  async function handleViewTracking() {
    const container = document.querySelector('[data-entity-id]');
    if (!container) return;
    const entityId = container.getAttribute('data-entity-id');
    if (!entityId) return;

    const counter = document.getElementById('book-views-counter');
    const res = await trackView(entityId, 'book');
    if (res && res.viewsCount && counter) {
      counter.textContent = `${res.viewsCount} بازدید`;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', handleViewTracking);
  } else {
    handleViewTracking();
  }
</script>
