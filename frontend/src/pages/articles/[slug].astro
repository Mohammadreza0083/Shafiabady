---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import CommentList from '../../components/comments/CommentList.astro';
import { articlesApi, commentsApi } from '../../utils/api';
import { sanitizeHtml } from '../../utils/sanitize';
import { EntityType } from '../../types';
import { mockArticles, mockCommentsTree } from '../../data/mockData';

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

let cleanSlug = slug;
try {
  cleanSlug = decodeURIComponent(slug);
} catch {}

let articleData: any = null;

try {
  let res = await articlesApi.getBySlug(cleanSlug);
  if ((!res.isSuccess || !res.data) && slug !== cleanSlug) {
    res = await articlesApi.getBySlug(slug);
  }

  if (res.isSuccess && res.data) {
    const raw = res.data;
    let tagsList: string[] = [];
    if (Array.isArray(raw.tags)) {
      tagsList = raw.tags;
    } else if (typeof raw.tags === 'string' && raw.tags.trim()) {
      tagsList = raw.tags.split(',').map((t: string) => t.trim()).filter(Boolean);
    }

    articleData = {
      id: raw.id,
      title: raw.title || 'بدون عنوان',
      slug: raw.slug || cleanSlug,
      summary: raw.summary || '',
      content: raw.content || '',
      coverImage: raw.thumbnailUrl || 'https://shafieiabadi.ir/images/og-default.png',
      readTime: raw.readTimeMinutes ? `${raw.readTimeMinutes} دقیقه` : '۵ دقیقه',
      category: raw.categoryTitle || 'هوش مصنوعی',
      tags: tagsList,
      viewsCount: raw.viewsCount || 0,
      createdAt: raw.createdAt || new Date().toISOString(),
      author: {
        name: raw.authorName || 'دکتر محمد حسین شفیع‌آبادی',
        role: 'استاد دانشگاه و پژوهشگر ارشد مهندسی نرم‌افزار',
      },
    };
  }
} catch (e) {
  // Fallback to mock data if backend is offline
}

if (!articleData) {
  const fallback = mockArticles.find((a) => a.slug === slug || a.slug === cleanSlug);
  if (fallback) {
    let fallbackTags: string[] = [];
    if (Array.isArray(fallback.tags)) {
      fallbackTags = fallback.tags;
    } else if (typeof (fallback as any).tags === 'string' && (fallback as any).tags.trim()) {
      fallbackTags = (fallback as any).tags.split(',').map((t: string) => t.trim()).filter(Boolean);
    }
    articleData = {
      ...fallback,
      tags: fallbackTags,
      author: typeof fallback.author === 'object' && fallback.author !== null ? fallback.author : {
        name: 'دکتر محمد حسین شفیع‌آبادی',
        role: 'استاد دانشگاه و پژوهشگر ارشد مهندسی نرم‌افزار',
      },
    };
  } else {
    return Astro.redirect('/404');
  }
}

const article = articleData;
const authorName = article.author?.name || article.authorName || 'دکتر محمد حسین شفیع‌آبادی';
const authorRole = article.author?.role || 'استاد دانشگاه و پژوهشگر ارشد مهندسی نرم‌افزار';
const articleTags: string[] = Array.isArray(article.tags) ? article.tags : [];

let commentsTree: any[] = [];
let backendFetched = false;

try {
  if (article && article.id) {
    const commentsRes = await commentsApi.getTree(EntityType.Article, article.id);
    if (commentsRes.isSuccess && Array.isArray(commentsRes.data)) {
      backendFetched = true;
      const mapDto = (dto: any): any => ({
        id: dto.id,
        authorName: dto.guestName || dto.authorName || 'کاربر مهمان',
        authorEmail: dto.email || dto.authorEmail || '',
        content: dto.text || dto.content || '',
        createdAt: dto.createdAt || new Date().toISOString(),
        replies: (dto.replies || []).map(mapDto),
      });
      commentsTree = commentsRes.data.map(mapDto);
    }
  }
} catch (e) {}

if (!backendFetched) {
  commentsTree = mockCommentsTree;
}

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': `https://shafieiabadi.ir/articles/${article.slug}`,
  },
  'headline': article.title,
  'description': article.summary,
  'image': article.coverImage || 'https://shafieiabadi.ir/images/og-default.png',
  'author': {
    '@type': 'Person',
    'name': authorName,
    'url': 'https://shafieiabadi.ir/about',
  },
  'publisher': {
    '@type': 'Person',
    'name': 'دکتر محمد حسین شفیع‌آبادی',
    'url': 'https://shafieiabadi.ir',
  },
  'datePublished': article.createdAt,
  'dateModified': article.createdAt,
  'keywords': articleTags.join(', '),
  'articleSection': article.category || 'عمومی',
};
---

<BaseLayout
  title={article.title}
  description={article.summary}
  pageType="article"
  ogImage={article.coverImage || undefined}
  jsonLd={articleJsonLd}
  articleData={{
    publishedTime: article.createdAt,
    author: authorName,
    tags: articleTags,
  }}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16" data-entity-id={article.id}>
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-neutral-400 dark:text-neutral-500 mb-8">
      <a href="/" class="hover:text-neutral-700 dark:hover:text-neutral-300">خانه</a>
      <span>/</span>
      <a href="/articles" class="hover:text-neutral-700 dark:hover:text-neutral-300">مقالات</a>
      <span>/</span>
      <span class="text-neutral-600 dark:text-neutral-400 truncate max-w-[200px]">{article.title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-10 text-center sm:text-right">
      <!-- Category & Metadata -->
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 mb-6">
        <span class="px-3.5 py-1 rounded-full text-xs font-semibold bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/20 dark:text-apple-blue-dark border border-apple-blue/15">
          {article.category}
        </span>
        <span class="text-xs text-neutral-400 dark:text-neutral-500">
          {article.createdAt ? new Date(article.createdAt).toLocaleDateString('fa-IR', { year: 'numeric', month: 'long', day: 'numeric' }) : ''}
        </span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span class="text-xs text-neutral-500 dark:text-neutral-400 flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>زمان مطالعه: {article.readTime}</span>
        </span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span class="text-xs text-neutral-500 dark:text-neutral-400 flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          <span id="article-views-counter">{article.viewsCount} بازدید</span>
        </span>
      </div>

      <!-- Article Main Title -->
      <h1 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-neutral-950 dark:text-white tracking-tight leading-snug sm:leading-tight mb-6">
        {article.title}
      </h1>

      <!-- Summary Lead Box -->
      <div class="p-6 rounded-2xl bg-apple-surface dark:bg-neutral-900 border border-black/5 dark:border-white/10 text-neutral-700 dark:text-neutral-300 text-base sm:text-lg leading-relaxed text-right">
        {article.summary}
      </div>
    </header>

    <!-- Main Body Content -->
    <div class="prose prose-lg dark:prose-invert max-w-none text-neutral-800 dark:text-neutral-200 leading-loose space-y-6">
      <div set:html={sanitizeHtml(article.content)} />
    </div>

    <!-- Tags -->
    {
      articleTags.length > 0 && (
        <div class="mt-12 pt-8 border-t border-black/10 dark:border-white/10 flex flex-wrap items-center gap-2">
          <span class="text-xs font-semibold text-neutral-400 dark:text-neutral-500 ml-2">برچسب‌ها:</span>
          {
            articleTags.map((tag) => (
              <span class="px-3 py-1 rounded-full text-xs font-medium bg-black/5 dark:bg-white/5 text-neutral-700 dark:text-neutral-300 hover:bg-black/10 dark:hover:bg-white/10 transition-colors">
                #{tag}
              </span>
            ))
          }
        </div>
      )
    }

    <!-- Author Box -->
    <div class="mt-10 p-6 sm:p-8 rounded-3xl apple-card bg-gradient-to-r from-blue-50/50 via-sky-50/30 to-transparent dark:from-neutral-900 dark:via-neutral-900/80 dark:to-neutral-950 flex flex-col sm:flex-row items-center sm:items-start gap-6 text-center sm:text-right">
      <div class="w-20 h-20 rounded-2xl bg-apple-blue flex items-center justify-center text-white text-3xl font-extrabold shadow-lg shadow-apple-blue/25 flex-shrink-0">
        ش
      </div>
      <div>
        <h4 class="text-lg font-bold text-neutral-900 dark:text-white mb-1">
          {authorName}
        </h4>
        <span class="text-xs font-semibold text-apple-blue dark:text-apple-blue-dark block mb-3">
          {authorRole}
        </span>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
          عضو هیئت علمی و فعال حوزه هوش مصنوعی، تحول دیجیتال و توسعه کسب‌وکارهای فناورانه؛ همراه مدیران و سازمان‌ها در یادگیری، تصمیم‌گیری و اجرای راهکارهای کاربردی.
        </p>
      </div>
    </div>

    <!-- Recursive Comments Component -->
    <CommentList comments={commentsTree} entityId={article.id} entityType="article" />
  </article>
</BaseLayout>

<script>
  import { trackView } from '../../scripts/view-counter';

  async function handleViewTracking() {
    const articleEl = document.querySelector('article[data-entity-id]');
    if (!articleEl) return;

    const entityId = articleEl.getAttribute('data-entity-id');
    if (!entityId) return;

    const counterBadge = document.getElementById('article-views-counter');
    const result = await trackView(entityId, 'article');

    if (result && result.viewsCount && counterBadge) {
      counterBadge.textContent = `${result.viewsCount} بازدید`;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', handleViewTracking);
  } else {
    handleViewTracking();
  }
</script>
