---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import { mockCourses } from '../../data/mockData';

export function getStaticPaths() {
  return mockCourses.map((course) => ({
    params: { slug: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;

const courseJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  'name': course.title,
  'description': course.description,
  'provider': {
    '@type': 'Person',
    'name': 'دکتر محمد حسین شفیعآبادی',
    'url': 'https://shafieiabadi.ir/about',
  },
  'educationalLevel': course.level,
  'timeRequired': course.duration,
  'offers': {
    '@type': 'Offer',
    'price': course.isFree ? 0 : course.price,
    'priceCurrency': 'IRR',
    'availability': 'https://schema.org/InStock',
    'url': `https://shafieiabadi.ir/courses/${course.slug}`,
  },
  'inLanguage': 'fa',
};
---

<BaseLayout
  title={course.title}
  description={course.description}
  pageType="course"
  ogImage={course.thumbnail || undefined}
  jsonLd={courseJsonLd}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16" data-entity-id={course.id}>
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-neutral-400 dark:text-neutral-500 mb-8">
      <a href="/" class="hover:text-neutral-700 dark:hover:text-neutral-300">خانه</a>
      <span>/</span>
      <a href="/courses" class="hover:text-neutral-700 dark:hover:text-neutral-300">دوره‌ها</a>
      <span>/</span>
      <span class="text-neutral-600 dark:text-neutral-400 truncate max-w-[200px]">{course.title}</span>
    </nav>

    <!-- Header Section -->
    <div class="mb-10">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/20 dark:text-apple-blue-dark">
          سطح: {course.level}
        </span>
        {
          course.discountPercentage && (
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-rose-500 text-white shadow-sm">
              {course.discountPercentage}٪ تخفیف ویژه
            </span>
          )
        }
        <span class="text-xs text-neutral-400 dark:text-neutral-500">
          مدت زمان: {course.duration}
        </span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span class="text-xs text-neutral-400 dark:text-neutral-500">
          تعداد جلسات: {course.lessonsCount} جلسه
        </span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span id="course-views-counter" class="text-xs text-neutral-400 dark:text-neutral-500">
          {course.viewsCount} بازدید
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-neutral-950 dark:text-white tracking-tight leading-snug sm:leading-tight mb-6">
        {course.title}
      </h1>

      <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed">
        {course.description}
      </p>
    </div>

    <!-- Video / Action Preview Box -->
    <div class="p-8 rounded-3xl apple-card bg-neutral-900 text-white flex flex-col md:flex-row items-center justify-between gap-6 mb-12 shadow-2xl">
      <div class="space-y-2 text-center md:text-right">
        <span class="text-xs text-neutral-400 font-semibold uppercase tracking-wider">سرمایه‌گذاری برای این دوره</span>
        <div class="flex flex-col items-center md:items-start">
          {
            course.isFree ? (
              <span class="text-3xl font-extrabold text-emerald-400">رایگان و بدون هزینه</span>
            ) : course.originalPrice && course.originalPrice > course.price ? (
              <div>
                <span class="text-sm text-neutral-400 line-through block mb-1">
                  {course.originalPrice.toLocaleString('fa-IR')} تومان
                </span>
                <div class="text-3xl font-extrabold text-white flex items-baseline justify-center md:justify-start gap-2">
                  <span>{course.price.toLocaleString('fa-IR')}</span>
                  <span class="text-sm font-normal text-neutral-400">تومان</span>
                  {course.discountPercentage && (
                    <span class="mr-2 px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-500 text-white">
                      {course.discountPercentage}٪ تخفیف
                    </span>
                  )}
                </div>
              </div>
            ) : (
              <div class="text-3xl font-extrabold text-white flex items-baseline justify-center md:justify-start gap-2">
                <span>{course.price.toLocaleString('fa-IR')}</span>
                <span class="text-sm font-normal text-neutral-400">تومان</span>
              </div>
            )
          }
        </div>
        <p class="text-xs text-neutral-400">دسترسی مادام‌العمر + آپدیت‌های رایگان + پشتیبانی در انجمن</p>
      </div>

      <div class="w-full md:w-auto">
        <Button href="/contact" variant="primary" size="lg" className="w-full md:w-auto text-base">
          <span>ثبت‌نام و دسترسی فوری</span>
          <svg class="w-4 h-4 transform rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </Button>
      </div>
    </div>

    <!-- Course Syllabus & Overview -->
    <div class="space-y-8">
      <div>
        <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">
          سرفصل‌ها و مباحث آموزشی
        </h3>
        <div class="space-y-3">
          <div class="p-4 rounded-xl apple-card flex items-center justify-between text-sm">
            <span class="font-medium text-neutral-800 dark:text-neutral-200">فصل اول: مفاهیم بنیادین و معماری پیشرفته</span>
            <span class="text-xs text-neutral-400">۶ جلسه</span>
          </div>
          <div class="p-4 rounded-xl apple-card flex items-center justify-between text-sm">
            <span class="font-medium text-neutral-800 dark:text-neutral-200">فصل دوم: الگوهای طراحی دامنه‌محور (DDD) و CQRS</span>
            <span class="text-xs text-neutral-400">۱۲ جلسه</span>
          </div>
          <div class="p-4 rounded-xl apple-card flex items-center justify-between text-sm">
            <span class="font-medium text-neutral-800 dark:text-neutral-200">فصل سوم: تست‌نویسی TDD با xUnit، Moq و FluentAssertions</span>
            <span class="text-xs text-neutral-400">۸ جلسه</span>
          </div>
          <div class="p-4 rounded-xl apple-card flex items-center justify-between text-sm">
            <span class="font-medium text-neutral-800 dark:text-neutral-200">فصل چهارم: پیاده‌سازی پروژه نهایی Enterprise و استقرار در Docker</span>
            <span class="text-xs text-neutral-400">۱۴ جلسه</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { trackView } from '../../scripts/view-counter';

  async function handleViewTracking() {
    const container = document.querySelector('[data-entity-id]');
    if (!container) return;
    const entityId = container.getAttribute('data-entity-id');
    if (!entityId) return;

    const counter = document.getElementById('course-views-counter');
    const res = await trackView(entityId, 'course');
    if (res && res.viewsCount && counter) {
      counter.textContent = `${res.viewsCount} بازدید`;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', handleViewTracking);
  } else {
    handleViewTracking();
  }
</script>
