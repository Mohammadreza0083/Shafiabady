---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { profileUrls } from '../data/site';

const aboutText = 'کار من پیوند دادن دانش روز هوش مصنوعی و تجربه‌های موفق صنعت در جهان با نیاز واقعی کسب‌وکارهاست؛ با آموزش مدیران و طراحی راهکارهای کاربردی کمک می‌کنم فناوری از یک ایده جذاب به تصمیم‌های بهتر، اقدام مؤثر و رشد پایدار تبدیل شود.';

const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  'mainEntity': {
    '@type': 'Person',
    'name': 'محمد حسین شفیع آبادی',
    'jobTitle': 'عضو هیئت علمی دانشگاه، رئیس دانشکده هوش مصنوعی و فناوری‌های پیشرفته و استراتژیست توسعه کسب‌وکارهای فناورانه',
    'description': aboutText,
    'url': 'https://shafieiabadi.ir/about',
    'image': 'https://shafieiabadi.ir/images/portraits/thoughtful.webp',
    'sameAs': profileUrls,
    'alumniOf': [
      {
        '@type': 'EducationalOrganization',
        'name': 'دانشگاه آزاد اسلامی واحد علوم و تحقیقات'
      },
      {
        '@type': 'EducationalOrganization',
        'name': 'دانشگاه صنعتی امیرکبیر'
      },
      {
        '@type': 'EducationalOrganization',
        'name': 'دانشگاه شهید بهشتی'
      }
    ],
    'knowsAbout': [
      'هوش مصنوعی (Artificial Intelligence)',
      'معماری سیستم‌های کامپیوتری',
      'تحول دیجیتال (Digital Transformation)',
      'توسعه کسب‌وکارهای فناورانه',
      'آموزش مدیران',
      'پیوند دانشگاه و صنعت',
      'آینده‌پژوهی'
    ],
  },
};
---

<BaseLayout
  title="درباره من"
  description="درباره دکتر محمد حسین شفیع‌آبادی؛ عضو هیئت علمی دانشگاه، رئیس دانشکده هوش مصنوعی و فناوری‌های پیشرفته و همراه مدیران در به‌کارگیری هوش مصنوعی و توسعه کسب‌وکارهای فناورانه."
  pageType="profile"
  jsonLd={aboutJsonLd}
>
  <!-- Floating Apple-Style Slide Indicator (Desktop) -->
  <nav aria-label="راهنمای اسلایدها" class="fixed left-6 top-1/2 -translate-y-1/2 z-40 hidden lg:flex flex-col items-center gap-3 bg-white/70 dark:bg-black/60 backdrop-blur-xl p-2.5 rounded-full border border-black/5 dark:border-white/10 shadow-apple-md transition-opacity duration-300">
    <a href="#slide-1" class="slide-nav-dot w-2.5 h-2.5 rounded-full bg-apple-blue transition-all duration-300 hover:scale-125" title="درباره من" data-slide="slide-1"></a>
    <a href="#slide-2" class="slide-nav-dot w-2.5 h-2.5 rounded-full bg-neutral-300 dark:bg-neutral-700 transition-all duration-300 hover:scale-125 hover:bg-apple-blue" title="از شناخت فناوری تا خلق ارزش" data-slide="slide-2"></a>
    <a href="#slide-3" class="slide-nav-dot w-2.5 h-2.5 rounded-full bg-neutral-300 dark:bg-neutral-700 transition-all duration-300 hover:scale-125 hover:bg-apple-blue" title="از آموزش و پژوهش تا کسب‌وکار" data-slide="slide-3"></a>
    <a href="#slide-4" class="slide-nav-dot w-2.5 h-2.5 rounded-full bg-neutral-300 dark:bg-neutral-700 transition-all duration-300 hover:scale-125 hover:bg-apple-blue" title="سوابق تحصیلی" data-slide="slide-4"></a>
    <a href="#slide-5" class="slide-nav-dot w-2.5 h-2.5 rounded-full bg-neutral-300 dark:bg-neutral-700 transition-all duration-300 hover:scale-125 hover:bg-apple-blue" title="فراتر از نقش‌های حرفه‌ای و گفت‌وگو" data-slide="slide-5"></a>
  </nav>

  <!-- Full-Screen Scrollable Presentation Container -->
  <div id="slides-container" class="snap-container h-[calc(100vh-4rem)] overflow-y-auto snap-y snap-mandatory scroll-smooth relative">
    
    <!-- Slide 1: Identity, Portrait & About Statement -->
    <section id="slide-1" class="slide-section snap-start min-h-[calc(100vh-4rem)] flex items-center justify-center relative p-6 sm:p-10 lg:p-12 overflow-hidden">
      <!-- Glow Gradients -->
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-96 h-96 bg-apple-blue/15 dark:bg-apple-blue/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 right-1/4 w-72 h-72 bg-purple-500/10 dark:bg-purple-500/15 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-6xl mx-auto relative z-10 w-full grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Text (right in RTL) -->
        <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-right order-2 lg:order-1">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/20 dark:text-apple-blue-dark mb-4 border border-apple-blue/20 backdrop-blur-md">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="16" height="16" x="4" y="4" rx="2" />
              <rect width="6" height="6" x="9" y="9" rx="1" />
              <path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3" />
            </svg>
            عضو هیئت علمی دانشگاه • استراتژیست توسعه کسب‌وکارهای فناورانه
          </span>

          <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-neutral-950 dark:text-white tracking-tight leading-tight mb-6">
            محمد حسین شفیع آبادی
          </h1>

          <!-- About Statement Box -->
          <div class="apple-glass-card p-6 sm:p-8 rounded-3xl w-full relative border border-black/5 dark:border-white/10 shadow-apple-lg mb-6 group hover:border-apple-blue/40 transition-all duration-300">
            <span class="text-xs font-bold text-apple-blue dark:text-apple-blue-dark uppercase tracking-widest block mb-3">
              درباره من
            </span>
            <p class="text-base sm:text-lg md:text-xl text-neutral-800 dark:text-neutral-100 font-medium leading-loose">
              {aboutText}
            </p>
          </div>

          <!-- Quick Summary Badges -->
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2 sm:gap-3 text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 font-medium mb-4">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-neutral-100 dark:bg-neutral-800/80 border border-black/5 dark:border-white/5">
              🎓 عضو هیئت علمی از ۱۳۸۴
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-neutral-100 dark:bg-neutral-800/80 border border-black/5 dark:border-white/5">
              🤖 رئیس دانشکده هوش مصنوعی
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-neutral-100 dark:bg-neutral-800/80 border border-black/5 dark:border-white/5">
              ⚡ تحول دیجیتال
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-neutral-100 dark:bg-neutral-800/80 border border-black/5 dark:border-white/5">
              📚 آموزش مدیران
            </span>
          </div>

          <!-- Scroll Indicator -->
          <a href="#slide-2" class="animate-bounce mt-2 text-neutral-400 hover:text-apple-blue transition-colors focus:outline-none" aria-label="اسلاید بعدی">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
        </div>

        <!-- Portrait (left in RTL) -->
        <div class="lg:col-span-5 order-1 lg:order-2 flex justify-center">
          <div class="relative w-60 sm:w-80 lg:w-full max-w-md">
            <div class="absolute inset-x-6 bottom-0 top-1/4 rounded-[2.5rem] bg-gradient-to-tr from-apple-blue/25 to-purple-500/15 dark:from-apple-blue/30 dark:to-purple-500/20 blur-sm"></div>
            <img
              src="/images/portraits/thoughtful.webp"
              alt="پرتره دکتر محمد حسین شفیع‌آبادی"
              width="1074"
              height="1000"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="relative w-full h-auto object-contain drop-shadow-2xl"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Slide 2: Values & Approach (از شناخت فناوری تا خلق ارزش در کسب‌وکار) -->
    <section id="slide-2" class="slide-section snap-start min-h-[calc(100vh-4rem)] flex items-center justify-center relative p-6 sm:p-10 lg:p-12 bg-neutral-50/60 dark:bg-neutral-900/40">
      <div class="max-w-5xl mx-auto w-full">
        <div class="text-center mb-8 sm:mb-10">
          <span class="text-xs font-bold text-apple-blue dark:text-apple-blue-dark uppercase tracking-widest block mb-2">
            نگاه و رویکرد
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-neutral-950 dark:text-white tracking-tight">
            از شناخت فناوری تا خلق ارزش در کسب‌وکار
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Right box: فناوری در خدمت انسان و کسب‌وکار -->
          <div class="apple-glass-card p-6 sm:p-8 rounded-3xl text-right flex flex-col hover:border-apple-blue/30 transition-all duration-300">
            <div class="w-12 h-12 rounded-2xl bg-blue-500/10 text-apple-blue dark:text-apple-blue-dark flex items-center justify-center font-bold mb-5 shadow-sm">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">
              فناوری در خدمت انسان و کسب‌وکار
            </h3>
            <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
              باور دارم ارزش فناوری زمانی آشکار می‌شود که زندگی و کار را بهتر کند. در فعالیت‌های آموزشی، پژوهشی و مشاوره‌ای‌ام تلاش می‌کنم هوش مصنوعی را به نیازهای واقعی مدیران و سازمان‌ها پیوند بدهم.
            </p>
          </div>
          <!-- Middle box: آموزش و نشر دانش -->
          <div class="apple-glass-card p-6 sm:p-8 rounded-3xl text-right flex flex-col hover:border-purple-500/30 transition-all duration-300">
            <div class="w-12 h-12 rounded-2xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold mb-5 shadow-sm">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">
              آموزش و نشر دانش
            </h3>
            <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
              تدریس، تألیف و انتقال تجربه بخش مهمی از مسیر حرفه‌ای من است. از آموزش دانشجویان تا برگزاری دوره‌های سازمانی برای مدیران، هدفم ساده‌کردن مفاهیم پیچیده و تبدیل آن‌ها به دانشی قابل استفاده است.
            </p>
          </div>
          <!-- Left box: هوش مصنوعی در عمل -->
          <div class="apple-glass-card p-6 sm:p-8 rounded-3xl text-right flex flex-col hover:border-emerald-500/30 transition-all duration-300">
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold mb-5 shadow-sm">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="16" height="16" x="4" y="4" rx="2" />
                <rect width="6" height="6" x="9" y="9" rx="1" />
                <path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3">
              هوش مصنوعی در عمل
            </h3>
            <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
              به کسب‌وکارها کمک می‌کنم فرصت‌های کاربرد هوش مصنوعی را بشناسند، مدیران و تیم‌هایشان را آماده کنند و برای اجرای راهکارهای متناسب با نیاز خود مسیر روشنی داشته باشند.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Slide 3: Academic & Industry Path (از آموزش و پژوهش تا توسعه کسب‌وکارهای فناورانه) -->
    <section id="slide-3" class="slide-section snap-start min-h-[calc(100vh-4rem)] flex items-center justify-center relative p-6 sm:p-10 lg:p-12">
      <div class="max-w-5xl mx-auto w-full text-right">
        <div class="text-center mb-8 sm:mb-10">
          <span class="text-xs font-bold text-apple-blue dark:text-apple-blue-dark uppercase tracking-widest block mb-2">
            مسیر حرفه‌ای
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-neutral-950 dark:text-white tracking-tight">
            از آموزش و پژوهش تا توسعه کسب‌وکارهای فناورانه
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
          <!-- Right card: مسیر علمی و دانشگاهی -->
          <div class="apple-card p-6 sm:p-8 rounded-3xl flex flex-col justify-between border border-black/5 dark:border-white/10 hover:border-apple-blue/30 transition-all duration-300">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-2xl bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/20 dark:text-apple-blue-dark flex items-center justify-center shadow-sm">
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                    <path d="M6 12v5c3 3 9 3 12 0v-5" />
                  </svg>
                </div>
                <span class="text-xs font-bold px-3 py-1 rounded-full bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/20 dark:text-apple-blue-dark">
                  ۱۳۸۴ - اکنون
                </span>
              </div>

              <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-3">
                مسیر علمی و دانشگاهی
              </h3>

              <p class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed">
                از سال ۱۳۸۴ عضو هیئت علمی دانشگاه آزاد اسلامی هستم. تحصیلاتم را در مهندسی کامپیوتر، از کارشناسی سخت‌افزار تا کارشناسی ارشد و دکتری معماری سیستم‌های کامپیوتری، گذرانده‌ام. در کنار تدریس و راهنمایی پژوهش‌ها، اکنون ریاست دانشکده هوش مصنوعی و فناوری‌های پیشرفته و مدیریت گروه مهندسی کامپیوتر واحد اسلامشهر را بر عهده دارم.
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-black/5 dark:border-white/5 flex flex-wrap items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
              <span class="inline-flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800 px-2.5 py-1 rounded-lg">
                عضو هیئت علمی از ۱۳۸۴
              </span>
              <span class="inline-flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800 px-2.5 py-1 rounded-lg">
                رئیس دانشکده هوش مصنوعی
              </span>
              <span class="inline-flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800 px-2.5 py-1 rounded-lg">
                مدیر گروه مهندسی کامپیوتر
              </span>
            </div>
          </div>

          <!-- Left card: فعالیت در صنعت و آموزش مدیران -->
          <div class="apple-card p-6 sm:p-8 rounded-3xl flex flex-col justify-between border border-black/5 dark:border-white/10 hover:border-apple-blue/30 transition-all duration-300">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-2xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shadow-sm">
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="14" x="2" y="7" rx="2" ry="2" />
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                  </svg>
                </div>
                <span class="text-xs font-bold px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-600 dark:bg-indigo-500/20 dark:text-indigo-400">
                  صنعت و سازمان‌ها
                </span>
              </div>

              <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-3">
                فعالیت در صنعت و آموزش مدیران
              </h3>

              <p class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed">
                فعالیت من به کلاس درس محدود نمی‌شود. در همکاری با سازمان‌ها و کسب‌وکارها، بر توسعه کسب‌وکارهای فناورانه، تحول دیجیتال و کاربرد عملی هوش مصنوعی تمرکز دارم. همچنین با طراحی و تدریس دوره‌های سازمانی، به مدیران و تیم‌ها کمک می‌کنم فرصت‌های فناوری را بشناسند و برای استفاده از آن‌ها تصمیم‌های روشن‌تری بگیرند.
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-black/5 dark:border-white/5 flex flex-wrap items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
              <span class="inline-flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800 px-2.5 py-1 rounded-lg">
                توسعه کسب‌وکار
              </span>
              <span class="inline-flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800 px-2.5 py-1 rounded-lg">
                تحول دیجیتال
              </span>
              <span class="inline-flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800 px-2.5 py-1 rounded-lg">
                آموزش مدیران
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Slide 4: Academic Background (سوابق تحصیلی) -->
    <section id="slide-4" class="slide-section snap-start min-h-[calc(100vh-4rem)] flex items-center justify-center relative p-6 sm:p-10 lg:p-12 bg-neutral-50/60 dark:bg-neutral-900/40">
      <div class="max-w-5xl mx-auto w-full text-right">
        <div class="text-center mb-8 sm:mb-10">
          <span class="text-xs font-bold text-apple-blue dark:text-apple-blue-dark uppercase tracking-widest block mb-2">
            سوابق تحصیلی
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-neutral-950 dark:text-white tracking-tight">
            مدارج دانشگاهی و تخصص‌های آکادمیک
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- دکتری -->
          <div class="apple-glass-card p-6 sm:p-8 rounded-3xl relative overflow-hidden group hover:border-apple-blue/40 transition-all duration-300">
            <div class="w-12 h-12 rounded-2xl bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/20 dark:text-apple-blue-dark flex items-center justify-center mb-6 shadow-sm">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="6" />
                <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
              </svg>
            </div>

            <span class="inline-flex items-center gap-1 text-xs font-bold px-3 py-1 rounded-full bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/20 dark:text-apple-blue-dark mb-3">
              مقطع دکتری تخصصی (Ph.D.)
            </span>

            <h3 class="text-xl font-bold text-neutral-950 dark:text-white mb-4">
              دکتری
