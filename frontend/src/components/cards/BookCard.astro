---
import type { Book, BookDto } from '../../types';

interface Props {
  book: Book | BookDto | any;
}

const { book } = Astro.props;

const title = book.title || '';
const slug = book.slug || '';
const description = book.description || '';
const coverImage = book.coverImage || book.thumbnailUrl || '';
const publisher = book.publisher || 'انتشارات دانشگاهی';
const pagesCount = book.pagesCount ?? 0;
const viewsCount = book.viewsCount ?? 0;
const publishYear = book.publishYear || '۱۴۰۳';
---

<div class="group apple-card p-6 flex flex-col justify-between reveal-on-scroll">
  <div class="flex flex-col items-center text-center">
    <!-- Book 3D Mockup Cover -->
    <div class="relative w-44 h-60 mb-6 rounded-xl overflow-hidden shadow-xl group-hover:shadow-2xl group-hover:-translate-y-2 transition-all duration-300 bg-neutral-900 border border-white/10 flex items-center justify-center">
      {
        coverImage ? (
          <img
            src={coverImage}
            alt={`طرح جلد کتاب ${title}`}
            width="176"
            height="240"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
        ) : (
          <div class="p-4 flex flex-col items-center justify-center text-white h-full w-full bg-gradient-to-br from-neutral-800 via-neutral-900 to-black">
            <div class="w-10 h-10 rounded-lg bg-apple-blue flex items-center justify-center text-white font-bold mb-3 shadow-md">
              ک
            </div>
            <span class="text-xs font-bold leading-tight line-clamp-3 mb-2">{title}</span>
            <span class="text-[10px] text-neutral-400">{publishYear}</span>
          </div>
        )
      }
    </div>

    <!-- Metadata -->
    <div class="flex items-center gap-2 text-xs text-neutral-400 dark:text-neutral-500 mb-2">
      <span>{publisher}</span>
      <span>•</span>
      <span>{pagesCount} صفحه</span>
    </div>

    <h3 class="text-lg font-bold text-neutral-900 dark:text-white group-hover:text-apple-blue dark:group-hover:text-apple-blue-dark transition-colors mb-2">
      <a href={`/books/${slug}`}>
        {title}
      </a>
    </h3>

    <p class="text-xs text-neutral-600 dark:text-neutral-400 line-clamp-2 leading-relaxed mb-4">
      {description}
    </p>
  </div>

  <div class="pt-4 border-t border-black/5 dark:border-white/5 flex items-center justify-between">
    <span class="text-xs text-neutral-400 dark:text-neutral-500">
      {viewsCount} بازدید
    </span>
    <a
      href={`/books/${slug}`}
      class="text-xs font-semibold text-apple-blue dark:text-apple-blue-dark hover:underline flex items-center gap-1"
    >
      <span>مشاهده جزئیات</span>
      <svg class="w-3.5 h-3.5 transform rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>
