{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "System & API Health Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "req/sec", "axisPlacement": "auto", "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "title": "HTTP Request Rate (by Controller)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_received_total{application=\"ShafieiAbadi.Api\"}[1m])) by (controller)",
          "legendFormat": "{{controller}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "count", "axisPlacement": "auto", "drawStyle": "bars", "lineWidth": 1 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "title": "HTTP Response Codes (2xx, 4xx, 5xx)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_received_total{application=\"ShafieiAbadi.Api\"}[1m])) by (code)",
          "legendFormat": "Status {{code}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "seconds", "axisPlacement": "auto", "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "title": "Request Duration (p95 / p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{application=\"ShafieiAbadi.Api\"}[5m])) by (le))",
          "legendFormat": "p95 Duration",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{application=\"ShafieiAbadi.Api\"}[5m])) by (le))",
          "legendFormat": "p99 Duration",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": ".NET 9 Runtime Memory & GC",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "bytes", "axisPlacement": "auto", "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Process Working Set & GC Heap Size",
      "type": "timeseries",
      "targets": [
        {
          "expr": "process_working_set_bytes{application=\"ShafieiAbadi.Api\"}",
          "legendFormat": "Working Set",
          "refId": "A"
        },
        {
          "expr": "dotnet_gc_heap_size_bytes{application=\"ShafieiAbadi.Api\"}",
          "legendFormat": "GC Heap Size",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "threads", "axisPlacement": "auto", "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "ThreadPool Active & Pending Threads",
      "type": "timeseries",
      "targets": [
        {
          "expr": "dotnet_threadpool_thread_count{application=\"ShafieiAbadi.Api\"}",
          "legendFormat": "Active Threads",
          "refId": "A"
        },
        {
          "expr": "dotnet_threadpool_queue_length{application=\"ShafieiAbadi.Api\"}",
          "legendFormat": "Queued Work Items",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Live Structured Logs (Loki)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 19 },
      "id": 6,
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "Live Application Logs from Loki",
      "type": "logs",
      "targets": [
        {
          "expr": "{job=~\".+\"}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["shafieiabadi", "dotnet9", "astro", "production"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "timezone": "browser",
  "title": "ShafieiAbadi Platform - System Overview",
  "uid": "shafieiabadi-overview",
  "version": 1
}
