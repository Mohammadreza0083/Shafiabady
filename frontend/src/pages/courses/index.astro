---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseCard from '../../components/cards/CourseCard.astro';
import { coursesApi } from '../../utils/api';
import { mockCourses } from '../../data/mockData';
import type { CourseDto } from '../../types';

const PAGE_SIZE = 10;
let courses: any[] = [];

try {
  const response = await coursesApi.getPaged({ pageNumber: 1, pageSize: PAGE_SIZE });
  if (response.isSuccess && response.data && response.data.items && response.data.items.length > 0) {
    courses = response.data.items;
  } else {
    courses = mockCourses;
  }
} catch (error) {
  courses = mockCourses;
}
---

<BaseLayout
  title="دوره‌های آموزشی تخصصی"
  description="دوره‌های آموزشی پروژه-محور در زمینه معماری تمیز، میکروسرویس‌ها و بهینه‌سازی دات‌نت."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/20 dark:text-apple-blue-dark mb-4">
        آکادمی و آموزش حرفه‌ای
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-neutral-950 dark:text-white tracking-tight leading-tight mb-4">
        دوره‌های جامع و پیشرفته
      </h1>
      <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400">
        آموزش‌های عمیق، استاندارد و پروژه-محور با تمرکز بر نیازهای واقعی پروژه‌های تجاری و سازمانی.
      </p>
    </div>

    <!-- Courses Grid - Full array rendered with NO slicing -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {courses.map((course) => <CourseCard course={course} />)}
    </div>
  </div>
</BaseLayout>
