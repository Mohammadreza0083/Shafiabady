---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/ui/HeroSlider.astro';
import ArticleCard from '../components/cards/ArticleCard.astro';
import BookCard from '../components/cards/BookCard.astro';
import CourseCard from '../components/cards/CourseCard.astro';
import Button from '../components/ui/Button.astro';
import ContactCta from '../components/ContactCta.astro';
import { profileUrls } from '../data/site';
import { articlesApi, booksApi, coursesApi } from '../utils/api';
import { mockArticles, mockBooks, mockCourses } from '../data/mockData';

let featuredArticles: any[] = [];
let featuredBooks: any[] = [];
let featuredCourses: any[] = [];

try {
  const [articlesRes, booksRes, coursesRes] = await Promise.all([
    articlesApi.getPaged({ pageNumber: 1, pageSize: 3 }),
    booksApi.getPaged({ pageNumber: 1, pageSize: 3 }),
    coursesApi.getPaged({ pageNumber: 1, pageSize: 3 }),
  ]);

  featuredArticles = articlesRes.isSuccess && articlesRes.data?.items?.length
    ? articlesRes.data.items
    : mockArticles.slice(0, 3);

  featuredBooks = booksRes.isSuccess && booksRes.data?.items?.length
    ? booksRes.data.items
    : mockBooks.slice(0, 3);

  featuredCourses = coursesRes.isSuccess && coursesRes.data?.items?.length
    ? coursesRes.data.items
    : mockCourses.slice(0, 3);
} catch (e) {
  featuredArticles = mockArticles.slice(0, 3);
  featuredBooks = mockBooks.slice(0, 3);
  featuredCourses = mockCourses.slice(0, 3);
}

const homeDescription = 'دکتر محمد حسین شفیع‌آبادی؛ عضو هیئت علمی دانشگاه و استراتژیست توسعه کسب‌وکارهای فناورانه. هوش مصنوعی کاربردی، تحول دیجیتال، پیوند دانشگاه و صنعت و آموزش مدیران.';

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://shafieiabadi.ir/#website',
      'url': 'https://shafieiabadi.ir',
      'name': 'دکتر محمد حسین شفیع‌آبادی',
      'description': homeDescription,
      'inLanguage': 'fa-IR',
    },
    {
      '@type': 'Person',
      '@id': 'https://shafieiabadi.ir/#person',
      'name': 'دکتر محمد حسین شفیع‌آبادی',
      'jobTitle': 'عضو هیئت علمی دانشگاه | استراتژیست توسعه کسب‌وکارهای فناورانه',
      'description': 'عضو هیئت علمی و فعال حوزه هوش مصنوعی، تحول دیجیتال و توسعه کسب‌وکارهای فناورانه؛ همراه مدیران و سازمان‌ها در یادگیری، تصمیم‌گیری و اجرای راهکارهای کاربردی.',
      'url': 'https://shafieiabadi.ir',
      'image': 'https://shafieiabadi.ir/images/portraits/thoughtful.webp',
      'sameAs': profileUrls,
      'knowsAbout': [
        'هوش مصنوعی',
        'تحول دیجیتال',
        'توسعه کسب‌وکارهای فناورانه',
        'آموزش مدیران',
        'آینده‌پژوهی',
      ],
    },
  ],
};
---

<BaseLayout
  description={homeDescription}
  jsonLd={homeJsonLd}
>
  <!-- Top Hero Banner Slider: four expertise topics with portraits -->
  <HeroSlider />

  <!-- Section 1: Featured Articles -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
      <div>
        <span class="text-xs font-bold text-apple-blue dark:text-apple-blue-dark uppercase tracking-widest block mb-2">
          دیدگاه‌ها و تجربه‌ها
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-neutral-950 dark:text-white tracking-tight">
          تازه‌ترین مقالات و تحلیل‌ها
        </h2>
      </div>
      <Button href="/articles" variant="secondary" size="md">
        <span>مشاهده همه مقالات</span>
        <svg class="w-4 h-4 transform rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </Button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {featuredArticles.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>

  <!-- Section 2: Featured Books -->
  <section class="bg-apple-surface dark:bg-neutral-950/60 py-16 sm:py-24 border-y border-black/5 dark:border-white/5 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-bold text-apple-blue dark:text-apple-blue-dark uppercase tracking-widest block mb-2">
            کتاب‌ها و تألیفات
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-neutral-950 dark:text-white tracking-tight">
            آثاری در زمینه هوش مصنوعی و کسب‌وکار
          </h2>
        </div>
        <Button href="/books" variant="secondary" size="md">
          <span>همه کتاب‌ها</span>
          <svg class="w-4 h-4 transform rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </Button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredBooks.map((book) => <BookCard book={book} />)}
      </div>
    </div>
  </section>

  <!-- Section 3: Featured Courses -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
      <div>
        <span class="text-xs font-bold text-apple-blue dark:text-apple-blue-dark uppercase tracking-widest block mb-2">
          آکادمی و دوره‌های آموزشی
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-neutral-950 dark:text-white tracking-tight">
          دوره‌های کاربردی برای مدیران و متخصصان
        </h2>
      </div>
      <Button href="/courses" variant="secondary" size="md">
        <span>مشاهده همه دوره‌ها</span>
        <svg class="w-4 h-4 transform rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </Button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {featuredCourses.map((course) => <CourseCard course={course} />)}
    </div>
  </section>

  <!-- Section 4: Contact CTA -->
  <ContactCta />
</BaseLayout>
