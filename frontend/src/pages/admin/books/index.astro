---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { mockBooks } from '../../../data/mockData';
---

<AdminLayout title="مدیریت کتاب‌ها و تألیفات" activeSection="books">
  <div class="max-w-7xl mx-auto space-y-6">
    
    <!-- Header with Action Button -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-black/5 dark:border-white/10">
      <div>
        <h1 class="text-2xl font-black text-neutral-950 dark:text-white">
          کتاب‌ها و تألیفات
        </h1>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
          مدیریت عناوین منتشر شده، اطلاعات ناشر و آمار بازدید کتب
        </p>
      </div>

      <button
        type="button"
        id="btn-add-book"
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-apple-blue hover:bg-blue-600 text-white text-xs font-bold shadow-md shadow-apple-blue/25 transition-all duration-200"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>افزودن کتاب جدید</span>
      </button>
    </div>

    <!-- Data Table Container -->
    <div class="rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-right text-xs">
          <thead class="bg-neutral-50 dark:bg-neutral-800/50 text-neutral-500 dark:text-neutral-400 font-semibold border-b border-black/5 dark:border-white/10">
            <tr>
              <th class="py-4 px-6">عنوان کتاب</th>
              <th class="py-4 px-6">ناشر</th>
              <th class="py-4 px-6">سال چاپ</th>
              <th class="py-4 px-6">تعداد صفحات</th>
              <th class="py-4 px-6">بازدید</th>
              <th class="py-4 px-6 text-center">عملیات</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-black/5 dark:divide-white/5">
            {
              mockBooks.map((book) => (
                <tr class="hover:bg-black/[0.02] dark:hover:bg-white/[0.02] transition-colors">
                  <td class="py-4 px-6">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-14 rounded-lg overflow-hidden bg-neutral-900 border border-white/10 flex-shrink-0 flex items-center justify-center text-white font-bold text-xs shadow-sm">
                        {book.coverImage ? (
                          <img src={book.coverImage} alt={book.title} class="w-full h-full object-cover" />
                        ) : (
                          'کتاب'
                        )}
                      </div>
                      <div class="flex flex-col">
                        <span class="font-bold text-neutral-900 dark:text-white text-sm max-w-xs truncate">
                          {book.title}
                        </span>
                        <span class="text-[11px] text-neutral-400 line-clamp-1">
                          {book.subtitle}
                        </span>
                      </div>
                    </div>
                  </td>
                  <td class="py-4 px-6 text-neutral-600 dark:text-neutral-300">
                    {book.publisher}
                  </td>
                  <td class="py-4 px-6 text-neutral-500 font-mono">
                    {book.publishYear}
                  </td>
                  <td class="py-4 px-6 text-neutral-500">
                    {book.pagesCount} صفحه
                  </td>
                  <td class="py-4 px-6 font-semibold text-neutral-700 dark:text-neutral-300">
                    {book.viewsCount.toLocaleString('fa-IR')}
                  </td>
                  <td class="py-4 px-6">
                    <div class="flex items-center justify-center gap-2">
                      <a
                        href={`/books/${book.slug}`}
                        target="_blank"
                        class="p-2 rounded-xl text-neutral-400 hover:text-apple-blue hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
                        title="مشاهده در سایت"
                      >
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                      </a>
                      <button
                        type="button"
                        class="edit-btn p-2 rounded-xl text-neutral-400 hover:text-amber-500 hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
                        title="ویرایش"
                        data-title={book.title}
                      >
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                      </button>
                      <button
                        type="button"
                        class="delete-btn p-2 rounded-xl text-neutral-400 hover:text-rose-500 hover:bg-rose-500/10 transition-colors"
                        title="حذف"
                        data-title={book.title}
                      >
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>

<script>
  document.getElementById('btn-add-book')?.addEventListener('click', () => {
    alert('فرم افزودن کتاب جدید در مودال یا صفحه ویرایش فعال خواهد شد.');
  });

  document.querySelectorAll('.delete-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const title = btn.getAttribute('data-title');
      if (confirm(`آیا از حذف کتاب «${title}» اطمینان دارید؟`)) {
        alert('درخواست حذف ثبت شد.');
      }
    });
  });
</script>
