---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/cards/BookCard.astro';
import { booksApi } from '../../utils/api';
import { mockBooks } from '../../data/mockData';
import type { BookDto } from '../../types';

const categories = ['همه', 'معماری نرم‌افزار', 'طراحی سیستم', 'کیفیت و تست'];
const currentCategory = Astro.url.searchParams.get('category') || 'همه';

const PAGE_SIZE = 10;
let books: any[] = [];

try {
  const response = await booksApi.getPaged({
    pageNumber: 1,
    pageSize: PAGE_SIZE,
    category: currentCategory !== 'همه' ? currentCategory : undefined,
  });

  if (response.isSuccess && response.data && response.data.items && response.data.items.length > 0) {
    books = response.data.items;
  } else {
    books = currentCategory === 'همه'
      ? mockBooks
      : mockBooks.filter(
          (b) =>
            b.category === currentCategory ||
            (b as any).categoryTitle === currentCategory ||
            (b as any).categorySlug === currentCategory
        );
  }
} catch (error) {
  books = currentCategory === 'همه'
    ? mockBooks
    : mockBooks.filter(
        (b) =>
          b.category === currentCategory ||
          (b as any).categoryTitle === currentCategory ||
          (b as any).categorySlug === currentCategory
      );
}
---

<BaseLayout
  title="کتاب‌ها و تألیفات"
  description="تألیفات و مراجع جامع معماری نرم‌افزار، طراحی سیستم‌های پرترافیک و توسعه آزمون‌محور."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/20 dark:text-apple-blue-dark mb-4">
        تألیفات و کتب تخصصی
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-neutral-950 dark:text-white tracking-tight leading-tight mb-4">
        کتاب‌های مرجع مهندسی نرم‌افزار
      </h1>
      <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400">
        منابع آموزشی مکتوب برای تعمیق دانش در معماری سیستم‌های توزیع‌شده و بهترین روش‌های کدنویسی حرفه‌ای.
      </p>
    </div>

    <!-- Category Filters -->
    <div class="flex items-center justify-start sm:justify-center gap-2 overflow-x-auto pb-4 mb-10 no-scrollbar" id="book-category-pills">
      {
        categories.map((cat) => {
          const isActive = cat === currentCategory;
          return (
            <button
              type="button"
              data-category={cat}
              class={`book-category-btn px-4 py-2 rounded-full text-xs sm:text-sm font-medium whitespace-nowrap transition-all duration-200 cursor-pointer ${
                isActive
                  ? 'bg-apple-blue text-white shadow-sm dark:bg-apple-blue-dark active-cat'
                  : 'bg-black/5 dark:bg-white/5 text-neutral-700 dark:text-neutral-300 hover:bg-black/10 dark:hover:bg-white/10'
              }`}
            >
              {cat}
            </button>
          );
        })
      }
    </div>

    <!-- Books Grid -->
    <div
      id="books-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
      data-category={currentCategory !== 'همه' ? currentCategory : ''}
    >
      {
        books.length > 0 ? (
          books.map((book) => <BookCard book={book} />)
        ) : (
          <div class="col-span-full py-16 text-center text-neutral-500 dark:text-neutral-400">
            هیچ کتابی در این دسته‌بندی یافت نشد.
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

<script>
  import { booksApi } from '../../utils/api';
  import type { BookDto } from '../../types';

  function renderBookCardHTML(book: BookDto): string {
    const title = book.title || '';
    const slug = book.slug || '';
    const description = book.description || '';
    const coverImage = (book as any).coverImage || book.thumbnailUrl || '';
    const publisher = book.publisher || 'انتشارات تخصصی';
    const pagesCount = book.pagesCount ?? 0;
    const viewsCount = book.viewsCount ?? 0;
    const publishYear = book.publishYear || '۱۴۰۴';

    return `
      <div class="group apple-card p-6 flex flex-col justify-between reveal-on-scroll revealed transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
        <div class="flex flex-col items-center text-center">
          <div class="relative w-44 h-60 mb-6 rounded-xl overflow-hidden shadow-xl group-hover:shadow-2xl group-hover:-translate-y-2 transition-all duration-300 bg-neutral-900 border border-white/10 flex items-center justify-center">
            ${
              coverImage
                ? `<img src="${coverImage}" alt="طرح جلد کتاب ${title}" width="176" height="240" loading="lazy" decoding="async" class="w-full h-full object-cover" />`
                : `<div class="p-4 flex flex-col items-center justify-center text-white h-full w-full bg-gradient-to-br from-neutral-800 via-neutral-900 to-black">
                    <div class="w-10 h-10 rounded-lg bg-apple-blue flex items-center justify-center text-white font-bold mb-3 shadow-md">ک</div>
                    <span class="text-xs font-bold leading-tight line-clamp-3 mb-2">${title}</span>
                    <span class="text-[10px] text-neutral-400">${publishYear}</span>
                  </div>`
            }
          </div>

          <div class="flex items-center gap-2 text-xs text-neutral-400 dark:text-neutral-500 mb-2">
            <span>${publisher}</span>
            <span>•</span>
            <span>${pagesCount} صفحه</span>
          </div>

          <h3 class="text-lg font-bold text-neutral-900 dark:text-white group-hover:text-apple-blue dark:group-hover:text-apple-blue-dark transition-colors mb-2">
            <a href="/books/${slug}">
              ${title}
            </a>
          </h3>

          <p class="text-xs text-neutral-600 dark:text-neutral-400 line-clamp-2 leading-relaxed mb-4">
            ${description}
          </p>
        </div>

        <div class="pt-4 border-t border-black/5 dark:border-white/5 flex items-center justify-between">
          <span class="text-xs text-neutral-400 dark:text-neutral-500">
            ${viewsCount} بازدید
          </span>
          <a
            href="/books/${slug}"
            class="text-xs font-semibold text-apple-blue dark:text-apple-blue-dark hover:underline flex items-center gap-1"
          >
            <span>مشاهده جزئیات</span>
            <svg class="w-3.5 h-3.5 transform rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    `;
  }

  const buttons = document.querySelectorAll<HTMLButtonElement>('.book-category-btn');
  const container = document.getElementById('books-grid');

  buttons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const selectedCategory = btn.getAttribute('data-category') || 'همه';

      // Update button styles
      buttons.forEach((b) => {
        b.classList.remove('bg-apple-blue', 'text-white', 'shadow-sm', 'dark:bg-apple-blue-dark', 'active-cat');
        b.classList.add('bg-black/5', 'dark:bg-white/5', 'text-neutral-700', 'dark:text-neutral-300');
      });
      btn.classList.remove('bg-black/5', 'dark:bg-white/5', 'text-neutral-700', 'dark:text-neutral-300');
      btn.classList.add('bg-apple-blue', 'text-white', 'shadow-sm', 'dark:bg-apple-blue-dark', 'active-cat');

      // Update URL query state
      const newUrl = selectedCategory === 'همه'
        ? window.location.pathname
        : `${window.location.pathname}?category=${encodeURIComponent(selectedCategory)}`;
      window.history.pushState({ category: selectedCategory }, '', newUrl);

      if (!container) return;
      container.setAttribute('data-category', selectedCategory === 'همه' ? '' : selectedCategory);

      try {
        const res = await booksApi.getPaged({
          pageNumber: 1,
          pageSize: 20,
          category: selectedCategory !== 'همه' ? selectedCategory : undefined,
        });

        if (res.isSuccess && res.data && res.data.items) {
          const items = res.data.items;
          if (items.length === 0) {
            container.innerHTML = '<div class="col-span-full py-16 text-center text-neutral-500 dark:text-neutral-400">هیچ کتابی در این دسته‌بندی یافت نشد.</div>';
          } else {
            container.innerHTML = items.map((b) => renderBookCardHTML(b)).join('');
            window.dispatchEvent(new CustomEvent('content-loaded'));
          }
        }
      } catch (err) {
        console.warn('Error loading books for category:', err);
      }
    });
  });

  window.addEventListener('popstate', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const cat = urlParams.get('category') || 'همه';
    const targetBtn = Array.from(buttons).find((b) => b.getAttribute('data-category') === cat);
    if (targetBtn) {
      targetBtn.click();
    }
  });
</script>
