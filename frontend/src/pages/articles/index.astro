---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { articlesApi, categoriesApi } from '../../utils/api';
import { mockArticles, mockCategories } from '../../data/mockData';
import type { ArticleDto } from '../../types';

interface CategoryOption {
  id?: string;
  title: string;
  slug: string;
}

const allOption: CategoryOption = { id: '', title: 'همه', slug: 'all' };

let categories: CategoryOption[] = [
  allOption,
  ...mockCategories.map((cat) => ({ id: cat.id, title: cat.title, slug: cat.slug })),
];

try {
  const catRes = await categoriesApi.getAll();
  if (catRes.isSuccess && catRes.data && catRes.data.length > 0) {
    categories = [
      allOption,
      ...catRes.data.map((c) => ({
        id: c.id,
        title: c.title,
        slug: c.slug || c.title,
      })),
    ];
  }
} catch {
  // Use fallback category list
}

const PAGE_SIZE = 10;
const rawCategoryParam = Astro.url.searchParams.get('category') || 'all';
const activeCategoryOption = categories.find(
  (c) => c.slug === rawCategoryParam || c.title === rawCategoryParam
) || allOption;

let articles: any[] = [];
let hasNextPage = false;
let initialTotalCount = 0;

try {
  const isFiltered = activeCategoryOption.slug !== 'all';
  const response = await articlesApi.getPaged({
    pageNumber: 1,
    pageSize: PAGE_SIZE,
    categorySlug: isFiltered ? activeCategoryOption.slug : undefined,
    category: isFiltered ? activeCategoryOption.title : undefined,
  });

  if (response.isSuccess && response.data && response.data.items && response.data.items.length > 0) {
    articles = response.data.items;
    hasNextPage = response.data.hasNextPage;
    initialTotalCount = response.data.totalCount;
  } else {
    articles = !isFiltered
      ? mockArticles
      : mockArticles.filter(
          (a) =>
            a.categorySlug === activeCategoryOption.slug ||
            a.categoryTitle === activeCategoryOption.title ||
            a.category === activeCategoryOption.title
        );
    hasNextPage = false;
  }
} catch (error) {
  const isFiltered = activeCategoryOption.slug !== 'all';
  articles = !isFiltered
    ? mockArticles
    : mockArticles.filter(
        (a) =>
          a.categorySlug === activeCategoryOption.slug ||
          a.categoryTitle === activeCategoryOption.title ||
          a.category === activeCategoryOption.title
      );
  hasNextPage = false;
}
---

<BaseLayout
  title="مقالات و تحلیل‌های تخصصی"
  description="نگاهی کاربردی به هوش مصنوعی، تحول دیجیتال، آموزش و توسعه کسب‌وکارهای فناورانه؛ از روندهای روز تا تجربه‌های اجرایی."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/20 dark:text-apple-blue-dark mb-4">
        دیدگاه‌ها و تجربه‌ها
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-neutral-950 dark:text-white tracking-tight leading-tight mb-4">
        مقالات و تحلیل‌های تخصصی
      </h1>
      <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400">
        نگاهی کاربردی به هوش مصنوعی، تحول دیجیتال، آموزش و توسعه کسب‌وکارهای فناورانه؛ از روندهای روز تا تجربه‌های اجرایی.
      </p>
    </div>

    <!-- Category Filters -->
    <div class="flex items-center justify-start sm:justify-center gap-2 overflow-x-auto pb-4 mb-10 no-scrollbar" id="category-pills-bar">
      {
        categories.map((cat) => {
          const isActive = cat.slug === activeCategoryOption.slug;
          return (
            <button
              type="button"
              data-category={cat.title}
              data-slug={cat.slug}
              data-id={cat.id || ''}
              class={`category-filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-medium whitespace-nowrap transition-all duration-200 cursor-pointer ${
                isActive
                  ? 'bg-apple-blue text-white shadow-sm dark:bg-apple-blue-dark active-cat'
                  : 'bg-black/5 dark:bg-white/5 text-neutral-700 dark:text-neutral-300 hover:bg-black/10 dark:hover:bg-white/10'
              }`}
            >
              {cat.title}
            </button>
          );
        })
      }
    </div>

    <!-- Articles Grid (Populated initially with full page size & dynamically augmented by infinite scroll) -->
    <div
      id="articles-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8"
      data-has-more={hasNextPage ? 'true' : 'false'}
      data-page-size={PAGE_SIZE}
      data-category={activeCategoryOption.slug !== 'all' ? activeCategoryOption.title : ''}
      data-slug={activeCategoryOption.slug}
    >
      {
        articles.length > 0 ? (
          articles.map((article) => (
            <ArticleCard article={article} />
          ))
        ) : (
          <div class="col-span-full py-16 text-center text-neutral-500 dark:text-neutral-400">
            هیچ مقاله‌ای در این دسته‌بندی یافت نشد.
          </div>
        )
      }
    </div>

    <!-- Infinite Scroll Sentinel & Loading Spinner -->
    <div id="scroll-sentinel" class="py-12 flex flex-col items-center justify-center">
      <div id="scroll-loading" class="flex items-center gap-3 text-sm text-neutral-500 dark:text-neutral-400 hidden">
        <svg class="animate-spin h-5 w-5 text-apple-blue dark:text-apple-blue-dark" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>در حال دریافت مقالات بیشتر...</span>
      </div>

      <div id="scroll-end" class={`text-sm text-neutral-400 dark:text-neutral-600 ${hasNextPage ? 'hidden' : ''}`}>
        ✨ شما به انتهای فهرست مقالات رسیدید.
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { setupInfiniteScroll } from '../../scripts/infinite-scroll';
  import { articlesApi } from '../../utils/api';
  import type { ArticleDto } from '../../types';

  let scrollController = setupInfiniteScroll();

  function renderCardHTML(article: ArticleDto): string {
    const title = article.title || '';
    const slug = article.slug || '';
    const summary = article.summary || '';
    const categoryName = article.categoryTitle || 'هوش مصنوعی';
    const readTime = article.readTimeMinutes ? `${article.readTimeMinutes} دقیقه` : '۵ دقیقه';
    const authorName = article.authorName || 'دکتر محمد حسین شفیع‌آبادی';
    const authorInitial = authorName ? authorName.trim().charAt(0) : 'ش';
    const dateFormatted = new Date(article.createdAt || Date.now()).toLocaleDateString('fa-IR');
    const viewsCount = article.viewsCount ?? 0;
    const viewsFormatted = viewsCount.toLocaleString('fa-IR');
    const thumbnailUrl = article.thumbnailUrl || '';

    return `
      <article class="group relative apple-card overflow-hidden flex flex-col justify-between reveal-on-scroll revealed transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
        <div class="relative overflow-hidden aspect-[16/10] bg-neutral-100 dark:bg-neutral-800">
          ${
            thumbnailUrl
              ? `<img src="${thumbnailUrl}" alt="تصویر مقاله ${title}" width="600" height="375" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105" />`
              : `<div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-500/10 via-sky-400/5 to-purple-500/10 p-6"><div class="text-apple-blue dark:text-apple-blue-dark font-bold text-4xl opacity-40">${categoryName}</div></div>`
          }
          <div class="absolute top-4 right-4 z-10">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white/90 dark:bg-black/90 backdrop-blur-md text-apple-blue dark:text-apple-blue-dark shadow-sm border border-black/5 dark:border-white/10">
              ${categoryName}
            </span>
          </div>
          <div class="absolute bottom-4 left-4 z-10">
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-medium bg-black/60 backdrop-blur-md text-white shadow-sm">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>${readTime}</span>
            </span>
          </div>
        </div>

        <div class="p-6 sm:p-7 flex flex-col justify-between flex-grow">
          <div>
            <div class="flex items-center gap-2 text-xs text-neutral-400 dark:text-neutral-500 mb-3">
              <span>${dateFormatted}</span>
              <span>•</span>
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <span class="entity-views-count" data-entity-id="${article.id}">${viewsFormatted} بازدید</span>
              </span>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-white group-hover:text-apple-blue dark:group-hover:text-apple-blue-dark transition-colors duration-200 leading-snug mb-3">
              <a href="/articles/${slug}" class="focus:outline-none">
                <span class="absolute inset-0 z-0"></span>
                ${title}
              </a>
            </h3>

            <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-3 leading-relaxed mb-4">
              ${summary}
            </p>
          </div>

          <div class="pt-4 border-t border-black/5 dark:border-white/5 flex items-center justify-between mt-auto">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-full bg-neutral-200 dark:bg-neutral-700 flex items-center justify-center text-xs font-semibold text-neutral-700 dark:text-neutral-300">
                ${authorInitial}
              </div>
              <span class="text-xs text-neutral-600 dark:text-neutral-400 font-medium">
                ${authorName}
              </span>
            </div>

            <span class="text-xs font-semibold text-apple-blue dark:text-apple-blue-dark inline-flex items-center gap-1 group-hover:translate-x-[-2px] transition-transform">
              <span>مطالعه مقاله</span>
              <svg class="w-3.5 h-3.5 transform rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </div>
        </div>
      </article>
    `;
  }

  // Bind click handlers to category buttons
  const buttons = document.querySelectorAll<HTMLButtonElement>('.category-filter-btn');
  const container = document.getElementById('articles-grid');
  const loading = document.getElementById('scroll-loading');
  const endMessage = document.getElementById('scroll-end');

  async function selectCategory(targetBtn: HTMLButtonElement, updateUrl = true) {
    const selectedSlug = targetBtn.getAttribute('data-slug') || 'all';
    const selectedCategory = targetBtn.getAttribute('data-category') || 'همه';
    const isAll = selectedSlug === 'all' || selectedCategory === 'همه';

    // 1. Toggle active styling across all pills
    buttons.forEach((b) => {
      b.classList.remove('bg-apple-blue', 'text-white', 'shadow-sm', 'dark:bg-apple-blue-dark', 'active-cat');
      b.classList.add('bg-black/5', 'dark:bg-white/5', 'text-neutral-700', 'dark:text-neutral-300');
    });
    targetBtn.classList.remove('bg-black/5', 'dark:bg-white/5', 'text-neutral-700', 'dark:text-neutral-300');
    targetBtn.classList.add('bg-apple-blue', 'text-white', 'shadow-sm', 'dark:bg-apple-blue-dark', 'active-cat');

    // 2. Synchronize URL state with history.pushState
    if (updateUrl) {
      const newUrl = isAll
        ? window.location.pathname
        : `${window.location.pathname}?category=${encodeURIComponent(selectedSlug)}`;
      window.history.pushState({ category: selectedSlug }, '', newUrl);
    }

    // 3. Disconnect active infinite scroll observer
    if (scrollController) {
      scrollController.disconnect();
    }

    if (!container) return;
    container.setAttribute('data-slug', isAll ? 'all' : selectedSlug);
    container.setAttribute('data-category', isAll ? '' : selectedCategory);

    // Show loading state
    if (loading) loading.classList.remove('hidden');
    if (endMessage) endMessage.classList.add('hidden');

    try {
      // 4. Fetch fresh page 1 articles with category filter
      const res = await articlesApi.getPaged({
        pageNumber: 1,
        pageSize: 10,
        categorySlug: isAll ? undefined : selectedSlug,
        category: isAll ? undefined : selectedCategory,
      });

      if (loading) loading.classList.add('hidden');

      if (res.isSuccess && res.data && res.data.items) {
        const items = res.data.items;
        container.setAttribute('data-has-more', res.data.hasNextPage ? 'true' : 'false');

        if (items.length === 0) {
          container.innerHTML = '<div class="col-span-full py-16 text-center text-neutral-500 dark:text-neutral-400">هیچ مقاله‌ای در این دسته‌بندی یافت نشد.</div>';
        } else {
          container.innerHTML = items.map((a) => renderCardHTML(a)).join('');
          window.dispatchEvent(new CustomEvent('content-loaded'));
        }

        if (res.data.hasNextPage) {
          if (endMessage) endMessage.classList.add('hidden');
        } else {
          if (endMessage) endMessage.classList.remove('hidden');
        }
      }
    } catch (err) {
      if (loading) loading.classList.add('hidden');
      console.warn('Error filtering articles by category:', err);
    }

    // 5. Reset and re-bind infinite scroll observer for the selected category
    scrollController = setupInfiniteScroll();
  }

  // Bind click event handlers
  buttons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      selectCategory(btn, true);
    });
  });

  // Client hydration: Check browser URL parameters on initial load
  function syncCategoryFromUrl() {
    const urlParams = new URLSearchParams(window.location.search);
    const catParam = urlParams.get('category');
    if (catParam && catParam !== 'all' && catParam !== 'همه') {
      const match = Array.from(buttons).find(
        (b) => b.getAttribute('data-slug') === catParam || b.getAttribute('data-category') === catParam
      );
      if (match && !match.classList.contains('active-cat')) {
        selectCategory(match, false);
      }
    }
  }

  // Handle browser back and forward navigation
  window.addEventListener('popstate', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const catParam = urlParams.get('category') || 'all';
    const match = Array.from(buttons).find(
      (b) => b.getAttribute('data-slug') === catParam || b.getAttribute('data-category') === catParam || (catParam === 'all' && b.getAttribute('data-slug') === 'all')
    );
    if (match) {
      selectCategory(match, false);
    }
  });

  // Run on hydration
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncCategoryFromUrl);
  } else {
    syncCategoryFromUrl();
  }
</script>
