---
export const prerender = false;

import ThemeToggle from '../../components/ThemeToggle.astro';
import '../../styles/global.css';
---

<!doctype html>
<html lang="fa" dir="rtl" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>ورود به پنل مدیریت | دکتر محمد حسین شفیع‌آبادی</title>
    <meta name="robots" content="noindex, nofollow" />

    <!-- Anti-FOUC Theme Initializer -->
    <script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem('theme');
          if (savedTheme === 'dark') {
            document.documentElement.classList.add('dark');
          } else if (savedTheme === 'light') {
            document.documentElement.classList.remove('dark');
          } else {
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (prefersDark) document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-neutral-100 dark:bg-neutral-950 text-neutral-900 dark:text-neutral-100 font-sans antialiased min-h-screen flex items-center justify-center p-4 relative overflow-hidden">
    
    <!-- Ambient Apple Glow Orbs -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-apple-blue/20 dark:bg-apple-blue/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-purple-500/15 dark:bg-purple-900/15 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Theme Switcher at Top-Left corner -->
    <div class="absolute top-6 left-6 z-20">
      <ThemeToggle />
    </div>

    <!-- Return to Website Link at Top-Right -->
    <div class="absolute top-6 right-6 z-20">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-neutral-500 hover:text-apple-blue dark:hover:text-apple-blue-dark transition-colors px-3 py-1.5 rounded-full bg-white/60 dark:bg-neutral-900/60 backdrop-blur-md border border-black/5 dark:border-white/10"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        <span>بازگشت به سایت</span>
      </a>
    </div>

    <!-- Login Container Card -->
    <div class="w-full max-w-md relative z-10">
      <div class="rounded-3xl sm:rounded-[2.5rem] p-8 sm:p-10 bg-white/80 dark:bg-neutral-900/80 backdrop-blur-2xl border border-black/5 dark:border-white/10 shadow-2xl">
        
        <!-- Header & Logo -->
        <div class="text-center mb-8">
          <div class="w-16 h-16 mx-auto rounded-3xl bg-apple-blue dark:bg-apple-blue-dark flex items-center justify-center text-white font-extrabold text-2xl shadow-xl shadow-apple-blue/30 mb-4 transform hover:scale-105 transition-transform">
            ش
          </div>
          <h1 class="text-xl sm:text-2xl font-black text-neutral-950 dark:text-white tracking-tight">
            ورود به پنل مدیریت
          </h1>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1.5 font-medium">
            پلتفرم اختصاصی دکتر محمد حسین شفیع‌آبادی
          </p>
        </div>

        <!-- Dynamic Error Alert Box -->
        <div
          id="login-error-alert"
          class="hidden mb-6 p-4 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 text-xs leading-relaxed flex items-start gap-2.5"
          role="alert"
        >
          <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span id="login-error-text">اطلاعات ورود نامعتبر است.</span>
        </div>

        <!-- Login Form -->
        <form id="admin-login-form" class="space-y-5">
          <div>
            <label for="username" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              نام کاربری یا ایمیل مدیریت
            </label>
            <div class="relative">
              <input
                type="text"
                id="username"
                name="username"
                required
                dir="ltr"
                placeholder="admin@shafieiabadi.ir"
                class="w-full px-4 py-3.5 pl-10 rounded-2xl bg-neutral-50 dark:bg-neutral-800/80 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
              />
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-neutral-400">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.206" />
                </svg>
              </div>
            </div>
          </div>

          <div>
            <label for="password" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              گذرواژه امن
            </label>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                dir="ltr"
                placeholder="••••••••••••"
                class="w-full px-4 py-3.5 pl-10 rounded-2xl bg-neutral-50 dark:bg-neutral-800/80 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
              />
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-neutral-400">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
            </div>
          </div>

          <!-- Remember Me Checkbox -->
          <div class="flex items-center justify-between text-xs">
            <label class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400 cursor-pointer select-none">
              <input
                type="checkbox"
                id="remember-me"
                class="w-4 h-4 rounded-lg text-apple-blue focus:ring-apple-blue border-black/10 dark:border-white/10 dark:bg-neutral-800"
              />
              <span>مرا به خاطر بسپار</span>
            </label>
          </div>

          <button
            type="submit"
            id="login-btn"
            class="w-full py-3.5 rounded-2xl bg-apple-blue hover:bg-blue-600 text-white font-bold text-sm shadow-lg shadow-apple-blue/30 transition-all duration-200 flex items-center justify-center gap-2 mt-2"
          >
            <span id="login-btn-text">ورود به داشبورد</span>
            <svg id="login-btn-arrow" class="w-4 h-4 transform rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>

      </div>
    </div>

  </body>
</html>

<script>
  import { authApi } from '../../utils/api';

  const form = document.getElementById('admin-login-form') as HTMLFormElement | null;
  const usernameInput = document.getElementById('username') as HTMLInputElement | null;
  const passwordInput = document.getElementById('password') as HTMLInputElement | null;
  const rememberMeInput = document.getElementById('remember-me') as HTMLInputElement | null;
  const btn = document.getElementById('login-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('login-btn-text');
  const btnArrow = document.getElementById('login-btn-arrow');
  const errorAlert = document.getElementById('login-error-alert');
  const errorText = document.getElementById('login-error-text');

  function showError(message: string) {
    if (errorAlert && errorText) {
      errorText.textContent = message;
      errorAlert.classList.remove('hidden');
    }
  }

  function hideError() {
    if (errorAlert) {
      errorAlert.classList.add('hidden');
    }
  }

  function setLoading(isLoading: boolean) {
    if (btn) {
      btn.disabled = isLoading;
      if (isLoading) {
        btn.classList.add('opacity-75', 'cursor-not-allowed');
        if (btnText) btnText.textContent = 'در حال بررسی اعتبار...';
        if (btnArrow) btnArrow.classList.add('hidden');
      } else {
        btn.classList.remove('opacity-75', 'cursor-not-allowed');
        if (btnText) btnText.textContent = 'ورود به داشبورد';
        if (btnArrow) btnArrow.classList.remove('hidden');
      }
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();

    const usernameOrEmail = usernameInput?.value?.trim() || '';
    const password = passwordInput?.value || '';
    const isRememberMe = rememberMeInput?.checked ?? false;

    if (!usernameOrEmail || !password) {
      showError('لطفاً نام کاربری و گذرواژه را وارد نمایید.');
      return;
    }

    setLoading(true);

    try {
      const result = await authApi.login({
        usernameOrEmail,
        password,
        rememberMe: isRememberMe,
      });

      if (result.isSuccess) {
        if (isRememberMe) {
          localStorage.setItem('admin_remember_me', 'true');
        } else {
          localStorage.removeItem('admin_remember_me');
        }

        if (btnText) btnText.textContent = 'ورود موفقیت‌آمیز! در حال انتقال...';
        setTimeout(() => {
          window.location.href = '/admin';
        }, 300);
      } else {
        showError(result.errorMessage || 'نام کاربری یا کلمه عبور وارد شده صحیح نمی‌باشد.');
        setLoading(false);
      }
    } catch (error: any) {
      showError('خطا در برقراری ارتباط با سرویس احراز هویت.');
      setLoading(false);
    }
  });
</script>
