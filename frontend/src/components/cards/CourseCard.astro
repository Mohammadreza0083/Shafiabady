---
import type { Course } from '../../types';

interface Props {
  course: Course;
}

const { course } = Astro.props;
---

<div class="group apple-card overflow-hidden flex flex-col justify-between reveal-on-scroll">
  <div>
    <!-- Thumbnail Image -->
    <div class="relative aspect-video bg-neutral-100 dark:bg-neutral-800 overflow-hidden">
      {
        course.thumbnail ? (
          <img
            src={course.thumbnail}
            alt={course.title}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center bg-gradient-to-tr from-neutral-900 to-neutral-800 text-white p-6">
            <div class="w-12 h-12 rounded-2xl bg-apple-blue/30 backdrop-blur-md flex items-center justify-center text-apple-blue-dark">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z" />
              </svg>
            </div>
          </div>
        )
      }

      <div class="absolute top-3 right-3 flex items-center gap-1.5">
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-white/90 dark:bg-black/90 backdrop-blur-md text-apple-blue dark:text-apple-blue-dark shadow-sm">
          {course.level}
        </span>
        {
          course.discountPercentage && (
            <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-rose-500 text-white shadow-sm">
              {course.discountPercentage}٪ تخفیف
            </span>
          )
        }
      </div>

      <div class="absolute bottom-3 left-3">
        <span class="px-2.5 py-1 rounded-full text-[11px] font-medium bg-black/60 backdrop-blur-md text-white shadow-sm flex items-center gap-1">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{course.duration}</span>
        </span>
      </div>
    </div>

    <!-- Course Content -->
    <div class="p-6">
      <div class="flex items-center gap-2 text-xs text-neutral-400 dark:text-neutral-500 mb-2">
        <span>{course.lessonsCount} جلسه آموزشی</span>
        <span>•</span>
        <span>{course.viewsCount} بازدید</span>
      </div>

      <h3 class="text-lg font-bold text-neutral-900 dark:text-white group-hover:text-apple-blue dark:group-hover:text-apple-blue-dark transition-colors mb-2">
        <a href={`/courses/${course.slug}`}>
          {course.title}
        </a>
      </h3>

      <p class="text-xs text-neutral-600 dark:text-neutral-400 line-clamp-2 leading-relaxed">
        {course.description}
      </p>
    </div>
  </div>

  <!-- Course Footer -->
  <div class="p-6 pt-0 flex items-center justify-between border-t border-black/5 dark:border-white/5 mt-4">
    <div>
      {
        course.isFree ? (
          <span class="text-sm font-bold text-emerald-600 dark:text-emerald-400">رایگان</span>
        ) : course.originalPrice && course.originalPrice > course.price ? (
          <div class="flex flex-col">
            <span class="text-[11px] text-neutral-400 line-through">
              {course.originalPrice.toLocaleString('fa-IR')} تومان
            </span>
            <div class="flex items-baseline gap-1">
              <span class="text-base font-extrabold text-neutral-950 dark:text-white">
                {course.price.toLocaleString('fa-IR')}
              </span>
              <span class="text-[10px] text-neutral-400">تومان</span>
            </div>
          </div>
        ) : (
          <div class="flex items-baseline gap-1">
            <span class="text-base font-bold text-neutral-950 dark:text-white">
              {course.price.toLocaleString('fa-IR')}
            </span>
            <span class="text-[10px] text-neutral-400">تومان</span>
          </div>
        )
      }
    </div>

    <a
      href={`/courses/${course.slug}`}
      class="px-4 py-2 rounded-full text-xs font-semibold bg-apple-blue/10 dark:bg-apple-blue-dark/20 text-apple-blue dark:text-apple-blue-dark hover:bg-apple-blue hover:text-white dark:hover:bg-apple-blue-dark dark:hover:text-white transition-all duration-200"
    >
      مشاهده دوره
    </a>
  </div>
</div>
