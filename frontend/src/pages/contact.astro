---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="تماس با من"
  description="فرم ارتباط مستقیم و ارسال پیام برای مشاوره‌های معماری، آموزش‌های سازمانی و پروژه‌های نرم‌افزاری."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
    <!-- Header Section -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/20 dark:text-apple-blue-dark mb-4">
        ارتباط مستقیم و همکاری
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-neutral-950 dark:text-white tracking-tight leading-tight mb-4">
        بیایید با هم گفتگو کنیم
      </h1>
      <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400">
        برای طرح پرسش، درخواست مشاوره معماری یا هماهنگی دوره‌های آموزشی، فرم زیر را تکمیل کنید. پیام شما فوراً از طریق ربات تلگرام اختصاصی بررسی می‌شود.
      </p>
    </div>

    <!-- Contact Form Card -->
    <div class="apple-glass-card p-8 sm:p-12 rounded-[2.5rem] shadow-xl">
      <form id="contact-form" class="space-y-6">
        <!-- Row 1: Name & Email -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="fullName" class="block text-xs font-bold text-neutral-700 dark:text-neutral-300 mb-2">
              نام و نام خانوادگی <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="fullName"
              name="fullName"
              required
              placeholder="مثال: علی رضایی"
              class="w-full px-4 py-3 rounded-2xl bg-white/70 dark:bg-neutral-800/70 border border-black/10 dark:border-white/10 text-sm text-neutral-900 dark:text-white placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-apple-blue/50 transition-all"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-bold text-neutral-700 dark:text-neutral-300 mb-2">
              آدرس ایمیل <span class="text-red-500">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="name@company.com"
              class="w-full px-4 py-3 rounded-2xl bg-white/70 dark:bg-neutral-800/70 border border-black/10 dark:border-white/10 text-sm text-neutral-900 dark:text-white placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-apple-blue/50 transition-all text-left dir-ltr"
            />
          </div>
        </div>

        <!-- Row 2: Phone & Telegram ID (Optional) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="phoneNumber" class="block text-xs font-bold text-neutral-700 dark:text-neutral-300 mb-2 flex items-center justify-between">
              <span>شماره تماس</span>
              <span class="text-[10px] font-normal text-neutral-400">اختیاری</span>
            </label>
            <input
              type="tel"
              id="phoneNumber"
              name="phoneNumber"
              placeholder="۰۹۱۲۳۴۵۶۷۸۹"
              class="w-full px-4 py-3 rounded-2xl bg-white/70 dark:bg-neutral-800/70 border border-black/10 dark:border-white/10 text-sm text-neutral-900 dark:text-white placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-apple-blue/50 transition-all text-left dir-ltr"
            />
          </div>

          <div>
            <label for="telegramId" class="block text-xs font-bold text-neutral-700 dark:text-neutral-300 mb-2 flex items-center justify-between">
              <span>آیدی تلگرام</span>
              <span class="text-[10px] font-normal text-neutral-400">اختیاری</span>
            </label>
            <div class="relative flex items-center">
              <span class="absolute right-4 text-sm text-neutral-400 font-mono">@</span>
              <input
                type="text"
                id="telegramId"
                name="telegramId"
                placeholder="username"
                class="w-full pr-8 pl-4 py-3 rounded-2xl bg-white/70 dark:bg-neutral-800/70 border border-black/10 dark:border-white/10 text-sm text-neutral-900 dark:text-white placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-apple-blue/50 transition-all text-left dir-ltr font-mono"
              />
            </div>
          </div>
        </div>

        <!-- Row 3: Message -->
        <div>
          <label for="message" class="block text-xs font-bold text-neutral-700 dark:text-neutral-300 mb-2">
            متن پیام <span class="text-red-500">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            placeholder="درباره پروژه، درخواست مشاوره یا موضوع مورد نظرتان توضیح دهید..."
            class="w-full px-4 py-3.5 rounded-2xl bg-white/70 dark:bg-neutral-800/70 border border-black/10 dark:border-white/10 text-sm text-neutral-900 dark:text-white placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-apple-blue/50 transition-all leading-relaxed"
          ></textarea>
        </div>

        <!-- Status Toast Alert -->
        <div id="form-feedback" class="hidden p-4 rounded-2xl text-sm font-medium transition-all" role="alert"></div>

        <!-- Submit Button -->
        <div class="flex items-center justify-between pt-2">
          <p class="text-[11px] text-neutral-400">
            اطلاعات شما با بالاترین ضوابط حریم خصوصی نگهداری خواهد شد.
          </p>
          <Button id="submit-btn" type="submit" variant="primary" size="lg" className="relative">
            <span id="btn-text">ارسال پیام مستقیم</span>
            <svg id="btn-icon" class="w-4 h-4 transform rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
            <svg id="btn-spinner" class="hidden w-4 h-4 animate-spin text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </Button>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const feedback = document.getElementById('form-feedback');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');
    const btnIcon = document.getElementById('btn-icon');
    const btnSpinner = document.getElementById('btn-spinner');

    if (!form || !feedback) return;

    const WEBHOOK_URL = import.meta.env.PUBLIC_CONTACT_WEBHOOK_URL || 'http://localhost:8000/contact-webhook';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const payload = {
        name: (formData.get('fullName') as string || '').trim(),
        email: (formData.get('email') as string || '').trim(),
        phone: (formData.get('phoneNumber') as string || '').trim() || null,
        telegram_id: (formData.get('telegramId') as string || '').trim() || null,
        message: (formData.get('message') as string || '').trim(),
      };

      if (!payload.name || !payload.email || !payload.message) {
        showToast('error', 'لطفاً تمامی فیلدهای اجباری (نام، ایمیل و متن پیام) را تکمیل کنید.');
        return;
      }

      setLoading(true);
      feedback.classList.add('hidden');

      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 12000);

        const response = await fetch(WEBHOOK_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });

        clearTimeout(timeoutId);

        const result = await response.json().catch(() => ({}));

        if (response.ok && result.success !== false) {
          showToast('success', '✨ پیام شما با موفقیت به ربات تلگرام ارسال شد. در اسرع وقت با شما تماس گرفته خواهد شد.');
          form.reset();
        } else {
          const errMsg = result.detail || result.message || 'خطا در پردازش درخواست.';
          showToast('error', `⚠️ متأسفانه پیام ارسال نشد: ${errMsg}`);
        }
      } catch (err: any) {
        if (err.name === 'AbortError') {
          showToast('error', '⚠️ مهلت زمان ارتباط با سرور به پایان رسید. لطفاً مجدداً تلاش کنید.');
        } else {
          showToast('error', '⚠️ امکان اتصال به میکروسرویس ارسال پیام وجود ندارد. لطفاً از روشن بودن سرور مطمئن شوید.');
        }
      } finally {
        setLoading(false);
      }
    });

    function setLoading(isLoading: boolean) {
      if (submitBtn) submitBtn.disabled = isLoading;
      if (btnText) btnText.textContent = isLoading ? 'در حال ارسال پیام...' : 'ارسال پیام مستقیم';
      if (btnIcon) btnIcon.classList.toggle('hidden', isLoading);
      if (btnSpinner) btnSpinner.classList.toggle('hidden', !isLoading);
    }

    function showToast(type: 'success' | 'error', message: string) {
      if (!feedback) return;
      feedback.className = type === 'success'
        ? 'p-4 rounded-2xl text-sm font-medium bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30 flex items-center gap-3 transition-all'
        : 'p-4 rounded-2xl text-sm font-medium bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-500/30 flex items-center gap-3 transition-all';

      const iconSvg = type === 'success'
        ? '<svg class="w-5 h-5 flex-shrink-0 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>'
        : '<svg class="w-5 h-5 flex-shrink-0 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>';

      feedback.innerHTML = `${iconSvg}<span>${message}</span>`;
      feedback.classList.remove('hidden');
      feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm);
  } else {
    initContactForm();
  }
</script>
