---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { coursesApi, categoriesApi } from '../../../../utils/api';
import type { CourseDto, CategoryDto } from '../../../../types';

const token = Astro.cookies.get('AdminAuthToken')?.value;
if (!token) {
  return Astro.redirect('/admin/login');
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/admin/courses');
}

let course: CourseDto | null = null;
let categories: CategoryDto[] = [];
let fetchError: string | null = null;

try {
  const [courseRes, catRes] = await Promise.all([
    coursesApi.getById(id, token),
    categoriesApi.getAll(),
  ]);

  if (courseRes.isSuccess && courseRes.data) {
    course = courseRes.data;
  } else if (courseRes.statusCode === 401) {
    return Astro.redirect('/admin/login');
  } else {
    fetchError = courseRes.errorMessage || 'دوره مورد نظر یافت نشد.';
  }

  if (catRes.isSuccess && catRes.data) {
    categories = catRes.data;
  }
} catch (e: any) {
  fetchError = e?.message || 'خطا در واکشی اطلاعات دوره از سرور';
}

if (!course) {
  return Astro.redirect('/admin/courses');
}
---

<AdminLayout title={`ویرایش دوره: ${course.title}`} activeSection="courses">
  <div class="max-w-5xl mx-auto space-y-6">
    
    <!-- Page Header -->
    <div class="flex items-center justify-between pb-4 border-b border-black/5 dark:border-white/10">
      <div>
        <h1 class="text-2xl font-black text-neutral-950 dark:text-white">
          ویرایش دوره آموزشی
        </h1>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
          ویرایش مشخصات، لینک ویدیوی آپارات، قیمت‌گذاری و سرفصل‌های «{course.title}»
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/courses"
          class="px-4 py-2 rounded-full border border-black/10 dark:border-white/10 text-xs font-semibold text-neutral-700 dark:text-neutral-300 hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
        >
          انصراف
        </a>
        <button
          type="button"
          id="btn-save-course"
          data-course-id={course.id}
          class="px-5 py-2 rounded-full bg-apple-blue hover:bg-blue-600 text-white text-xs font-bold shadow-md shadow-apple-blue/25 transition-all duration-200"
        >
          ذخیره تغییرات
        </button>
      </div>
    </div>

    {fetchError && (
      <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-xs">
        {fetchError}
      </div>
    )}

    <!-- Course Form -->
    <form id="course-edit-form" class="space-y-6">
      
      <!-- General Metadata Card -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm space-y-5">
        <h2 class="text-sm font-bold text-neutral-900 dark:text-white border-b border-black/5 dark:border-white/10 pb-3">
          اطلاعات اصلی دوره
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label for="title" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              عنوان دوره آموزشی <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="title"
              name="title"
              required
              value={course.title}
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>

          <div>
            <label for="slug" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              نامک آدرس (Slug) <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="slug"
              name="slug"
              required
              dir="ltr"
              value={course.slug}
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          <div>
            <label for="category" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              دسته‌بندی موضوعی
            </label>
            <select
              id="category"
              name="category"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            >
              <option value="">بدون دسته‌بندی</option>
              {
                categories.map((cat) => (
                  <option value={cat.id} selected={cat.id === course?.categoryId}>
                    {cat.title}
                  </option>
                ))
              }
            </select>
          </div>

          <div>
            <label for="level" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              سطح دوره
            </label>
            <select
              id="level"
              name="level"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            >
              <option value="پیشرفته" selected={course.level === 'پیشرفته'}>پیشرفته (Enterprise)</option>
              <option value="متوسط تا پیشرفته" selected={course.level === 'متوسط تا پیشرفته'}>متوسط تا پیشرفته</option>
              <option value="مقدماتی تا متوسط" selected={course.level === 'مقدماتی تا متوسط'}>مقدماتی تا متوسط</option>
              <option value="جامع (صفر تا صد)" selected={course.level === 'جامع (صفر تا صد)'}>جامع (صفر تا صد)</option>
            </select>
          </div>

          <div>
            <label for="duration" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              مدت زمان کل
            </label>
            <input
              type="text"
              id="duration"
              name="duration"
              value={course.duration}
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>

          <div>
            <label for="lessonsCount" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              تعداد جلسات
            </label>
            <input
              type="number"
              id="lessonsCount"
              name="lessonsCount"
              value={course.lessonsCount}
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>
        </div>

        <div>
          <label for="thumbnailUrl" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
            تصویر شاخص دوره (Thumbnail URL)
          </label>
          <input
            type="url"
            id="thumbnailUrl"
            name="thumbnailUrl"
            dir="ltr"
            value={course.thumbnailUrl || ''}
            class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
          />
        </div>
      </div>

      <!-- Aparat Video Embed URL -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm space-y-5">
        <h2 class="text-sm font-bold text-neutral-900 dark:text-white border-b border-black/5 dark:border-white/10 pb-3">
          ویدیوی معرفی دوره در آپارات (Aparat Video Embed URL)
        </h2>

        <div>
          <label for="aparatVideoUrl" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
            لینک ویدیو یا کد امبد آپارات
          </label>
          <input
            type="url"
            id="aparatVideoUrl"
            name="aparatVideoUrl"
            dir="ltr"
            value={course.aparatVideoUrl || ''}
            class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
          />
        </div>
      </div>

      <!-- Pricing -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm space-y-5">
        <h2 class="text-sm font-bold text-neutral-900 dark:text-white border-b border-black/5 dark:border-white/10 pb-3">
          شهریه و تخفیف‌های دوره
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          <div>
            <label for="originalPrice" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              قیمت اصلی (تومان) <span class="text-rose-500">*</span>
            </label>
            <input
              type="number"
              id="originalPrice"
              name="originalPrice"
              value={course.originalPrice}
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>

          <div>
            <label for="discountedPrice" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              قیمت پس از تخفیف (تومان)
            </label>
            <input
              type="number"
              id="discountedPrice"
              name="discountedPrice"
              value={course.discountedPrice || ''}
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>

          <div>
            <label for="discountPercentage" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
              درصد تخفیف (اختیاری)
            </label>
            <input
              type="number"
              id="discountPercentage"
              name="discountPercentage"
              value={course.discountPercentage || ''}
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
            />
          </div>
        </div>
      </div>

      <!-- Description -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-sm space-y-4">
        <h2 class="text-sm font-bold text-neutral-900 dark:text-white border-b border-black/5 dark:border-white/10 pb-3">
          توضیحات و سرفصل‌های دوره
        </h2>

        <div>
          <label for="description" class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
            شرح جامع دوره و پیش‌نیازها <span class="text-rose-500">*</span>
          </label>
          <textarea
            id="description"
            name="description"
            rows="5"
            required
            class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-apple-blue transition-all"
          >{course.description}</textarea>
        </div>
      </div>

    </form>
  </div>
</AdminLayout>

<script>
  import { coursesApi } from '../../../../utils/api';
  import { showToast, showAlert } from '../../../../utils/ui-dialog';

  const saveBtn = document.getElementById('btn-save-course');
  const courseId = saveBtn?.getAttribute('data-course-id');

  saveBtn?.addEventListener('click', async () => {
    if (!courseId) return;

    const title = (document.getElementById('title') as HTMLInputElement)?.value.trim();
    const slug = (document.getElementById('slug') as HTMLInputElement)?.value.trim();
    const level = (document.getElementById('level') as HTMLSelectElement)?.value || 'پیشرفته';
    const duration = (document.getElementById('duration') as HTMLInputElement)?.value.trim() || '۴۰ ساعت';
    const lessonsCount = parseInt((document.getElementById('lessonsCount') as HTMLInputElement)?.value || '30', 10);
    const thumbnailUrl = (document.getElementById('thumbnailUrl') as HTMLInputElement)?.value.trim() || 'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=800&q=80';
    const aparatVideoUrl = (document.getElementById('aparatVideoUrl') as HTMLInputElement)?.value.trim();
    const originalPrice = parseFloat((document.getElementById('originalPrice') as HTMLInputElement)?.value || '0');
    const discountedPriceVal = (document.getElementById('discountedPrice') as HTMLInputElement)?.value;
    const discountedPrice = discountedPriceVal ? parseFloat(discountedPriceVal) : null;
    const discountPercentageVal = (document.getElementById('discountPercentage') as HTMLInputElement)?.value;
    const discountPercentage = discountPercentageVal ? parseInt(discountPercentageVal, 10) : null;
    const description = (document.getElementById('description') as HTMLTextAreaElement)?.value.trim();
    const categorySelect = document.getElementById('category') as HTMLSelectElement;

    if (!title || !slug || !description) {
      showToast('لطفاً عنوان، نامک و توضیحات دوره را وارد فرمایید.', 'warning');
      return;
    }

    try {
      if (saveBtn) saveBtn.textContent = 'در حال ذخیره تغییرات...';
      const result = await coursesApi.update(courseId, {
        title,
        slug,
        level,
        duration,
        lessonsCount,
        thumbnailUrl,
        aparatVideoUrl: aparatVideoUrl || null,
        originalPrice,
        discountedPrice,
        discountPercentage,
        description,
        categoryId: categorySelect?.value ? categorySelect.value : null,
      });

      if (result.isSuccess) {
        await showAlert({
          title: 'بروزرسانی موفقیت‌آمیز',
          message: 'اطلاعات دوره با موفقیت بروزرسانی گردید.',
          type: 'success',
        });
        window.location.href = '/admin/courses';
      } else {
        showAlert({
          title: 'خطا در ویرایش دوره',
          message: result.errorMessage || 'خطا در ویرایش دوره',
          type: 'error',
        });
        if (saveBtn) saveBtn.textContent = 'ذخیره تغییرات';
      }
    } catch (e: any) {
      showToast('خطا در ارتباط با سرور', 'error');
      if (saveBtn) saveBtn.textContent = 'ذخیره تغییرات';
    }
  });
</script>
