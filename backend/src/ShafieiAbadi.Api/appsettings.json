{
  "UseInMemoryDatabase": true,
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ShafieiAbadiDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "SecretKey": "DrShafieiAbadi_SuperSecretKey_ProductionGrade_2026_DotNet9_CleanArch!",
    "Issuer": "ShafieiAbadi.Api",
    "Audience": "ShafieiAbadi.Client",
    "ExpirationMinutes": 5
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName", "WithThreadId" ],
    "Properties": {
      "Application": "ShafieiAbadi.Api"
    }
  },
  "Loki": {
    "Uri": "http://localhost:3100"
  },
  "AllowedCorsOrigins": [
    "http://localhost:4500",
    "http://localhost:4321",
    "http://localhost:3000",
    "http://127.0.0.1:4500",
    "http://127.0.0.1:4321"
  ]
}
