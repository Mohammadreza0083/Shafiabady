---
import ThemeToggle from '../components/ThemeToggle.astro';
import UiModal from '../components/UiModal.astro';
import '../styles/global.css';
import { viewsApi } from '../utils/api';

interface Props {
  title?: string;
  activeSection?: 'dashboard' | 'articles' | 'books' | 'courses' | 'categories' | 'comments';
}

const { title = 'پیش‌خوان مدیریت', activeSection = 'dashboard' } = Astro.props;

const currentPath = Astro.url.pathname;

// Extract HttpOnly session cookie to fetch live statistics for Admin Sidebar
const token = Astro.cookies.get('AdminAuthToken')?.value;
let pendingCommentsCount = 0;

if (token) {
  try {
    const statsRes = await viewsApi.getStats(token);
    if (statsRes.isSuccess && statsRes.data) {
      pendingCommentsCount = statsRes.data.pendingCommentsCount || 0;
    }
  } catch (e) {
    // Graceful fallback if backend is momentarily unreachable
  }
}

const sidebarLinks = [
  {
    id: 'dashboard',
    href: '/admin',
    label: 'داشبورد و آمار',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />`,
  },
  {
    id: 'articles',
    href: '/admin/articles',
    label: 'مدیریت مقالات',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />`,
  },
  {
    id: 'books',
    href: '/admin/books',
    label: 'مدیریت کتاب‌ها',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />`,
  },
  {
    id: 'courses',
    href: '/admin/courses',
    label: 'مدیریت دوره‌ها',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0020 6.818V4.182a1 1 0 00-.553-.894L15 1m0 9v13m0-13L3.447 4.182A1 1 0 003 5.076v13.848a1 1 0 001.447.894L15 14.273" />`,
  },
  {
    id: 'categories',
    href: '/admin/categories',
    label: 'مدیریت دسته‌بندی‌ها',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />`,
  },
  {
    id: 'comments',
    href: '/admin/comments',
    label: 'مدیریت نظرات',
    badge: pendingCommentsCount > 0 ? pendingCommentsCount.toLocaleString('fa-IR') : null,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />`,
  },
];
---

<!doctype html>
<html lang="fa" dir="rtl" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | پنل مدیریت دکتر محمد حسین شفیع‌آبادی</title>
    <meta name="robots" content="noindex, nofollow" />

    <!-- Anti-FOUC Theme Initializer -->
    <script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem('theme');
          if (savedTheme === 'dark') {
            document.documentElement.classList.add('dark');
          } else if (savedTheme === 'light') {
            document.documentElement.classList.remove('dark');
          } else {
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (prefersDark) document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-neutral-100 dark:bg-neutral-950 text-neutral-900 dark:text-neutral-100 font-sans antialiased min-h-screen flex flex-col md:flex-row">
    
    <!-- Sidebar -->
    <aside class="w-full md:w-64 lg:w-72 bg-white/80 dark:bg-neutral-900/80 backdrop-blur-2xl border-b md:border-b-0 md:border-l border-black/5 dark:border-white/10 flex-shrink-0 flex flex-col justify-between p-4 lg:p-6 sticky top-0 md:h-screen z-30">
      <div>
        <!-- Admin Brand Header -->
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-black/5 dark:border-white/10">
          <a href="/admin" class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-apple-blue dark:bg-apple-blue-dark flex items-center justify-center text-white font-extrabold text-xl shadow-lg shadow-apple-blue/25">
              ش
            </div>
            <div>
              <span class="font-extrabold text-base text-neutral-950 dark:text-white block">
                پنل مدیریت محتوا
              </span>
              <span class="text-[11px] text-neutral-400">
                دکتر محمد حسین شفیع‌آبادی
              </span>
            </div>
          </a>
          <div class="md:hidden">
            <ThemeToggle />
          </div>
        </div>

        <!-- Navigation Links -->
        <nav class="space-y-1.5">
          {
            sidebarLinks.map((link) => {
              const isActive = activeSection === link.id || (link.id !== 'dashboard' && currentPath.startsWith(link.href));
              return (
                <a
                  href={link.href}
                  class={`flex items-center justify-between px-3.5 py-3 rounded-2xl text-sm font-medium transition-all duration-200 ${
                    isActive
                      ? 'bg-apple-blue text-white shadow-md shadow-apple-blue/25 font-semibold'
                      : 'text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5'
                  }`}
                >
                  <div class="flex items-center gap-3">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={link.icon} />
                    <span>{link.label}</span>
                  </div>
                  {
                    link.id === 'comments' ? (
                      <span
                        id="sidebar-comments-badge"
                        class={`px-2 py-0.5 rounded-full text-xs font-bold ${isActive ? 'bg-white text-apple-blue' : 'bg-rose-500 text-white'} ${link.badge ? '' : 'hidden'}`}
                      >
                        {link.badge || '0'}
                      </span>
                    ) : link.badge ? (
                      <span class={`px-2 py-0.5 rounded-full text-xs font-bold ${isActive ? 'bg-white text-apple-blue' : 'bg-rose-500 text-white'}`}>
                        {link.badge}
                      </span>
                    ) : null
                  }
                </a>
              );
            })
          }
        </nav>
      </div>

      <!-- Sidebar Bottom Info & Actions -->
      <div class="pt-4 mt-6 border-t border-black/5 dark:border-white/10 space-y-2">
        <button
          type="button"
          id="sidebar-change-password-btn"
          class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-2xl text-xs font-medium text-neutral-600 dark:text-neutral-400 hover:text-apple-blue dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5 transition-all duration-200"
        >
          <svg class="w-4 h-4 text-apple-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
          </svg>
          <span>تغییر کلمه عبور</span>
        </button>

        <div class="flex items-center justify-between pt-1">
          <a
            href="/"
            target="_blank"
            class="flex items-center gap-2 text-xs font-semibold text-neutral-500 hover:text-apple-blue dark:hover:text-apple-blue-dark transition-colors"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 01-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            <span>مشاهده وب‌سایت</span>
          </a>

          <div class="hidden md:block">
            <ThemeToggle />
          </div>
        </div>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-grow flex flex-col min-h-screen overflow-x-hidden">
      <!-- Top Bar -->
      <header class="h-16 bg-white/60 dark:bg-neutral-900/60 backdrop-blur-xl border-b border-black/5 dark:border-white/10 px-6 lg:px-10 flex items-center justify-between sticky top-0 z-20">
        <div class="flex items-center gap-2 text-xs text-neutral-400">
          <a href="/admin" class="hover:text-neutral-700 dark:hover:text-neutral-300">مدیریت</a>
          <span>/</span>
          <span class="text-neutral-800 dark:text-neutral-200 font-semibold">{title}</span>
        </div>

        <div class="flex items-center gap-2.5">
          <span class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>سیستم آنلاین</span>
          </span>

          <!-- Visible Change Password button in Header -->
          <button
            type="button"
            id="admin-change-password-btn"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-neutral-700 dark:text-neutral-300 hover:text-apple-blue dark:hover:text-apple-blue hover:bg-apple-blue/10 dark:hover:bg-apple-blue/20 border border-black/10 dark:border-white/10 transition-colors shadow-sm"
            title="تغییر کلمه عبور"
          >
            <svg class="w-4 h-4 text-apple-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
            <span>تغییر کلمه عبور</span>
          </button>

          <button
            type="button"
            id="admin-logout-btn"
            class="inline-flex items-center gap-1.5 p-2 sm:px-3 sm:py-1.5 rounded-xl text-xs font-medium text-neutral-400 hover:text-rose-500 hover:bg-rose-500/10 border border-transparent hover:border-rose-500/20 transition-colors"
            title="خروج از حساب"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span class="hidden sm:inline">خروج</span>
          </button>
        </div>
      </header>

      <!-- Main Slot -->
      <main class="p-6 lg:p-10 flex-grow">
        <slot />
      </main>
    </div>

    <!-- Change Password Modal -->
    <div id="change-password-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm hidden" role="dialog" aria-modal="true">
      <div class="w-full max-w-md rounded-3xl p-6 bg-white dark:bg-neutral-900 border border-black/5 dark:border-white/10 shadow-2xl">
        <div class="flex items-center justify-between pb-4 border-b border-black/5 dark:border-white/10 mb-5">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-xl bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/20 dark:text-apple-blue-dark flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-neutral-900 dark:text-white">تغییر کلمه عبور مدیریت</h3>
          </div>
          <button type="button" id="close-change-password-btn" class="text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <form id="change-password-form" class="space-y-4">
          <div id="cp-error-alert" class="hidden p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-xs leading-relaxed"></div>
          
          <div>
            <label class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-1.5">کلمه عبور فعلی</label>
            <input type="password" id="current-password" required dir="ltr" placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:ring-2 focus:ring-apple-blue outline-none" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-1.5">کلمه عبور جدید (حداقل ۸ کاراکتر شامل حروف و اعداد)</label>
            <input type="password" id="new-password" required minlength="8" dir="ltr" placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:ring-2 focus:ring-apple-blue outline-none" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-1.5">تکرار کلمه عبور جدید</label>
            <input type="password" id="confirm-password" required minlength="8" dir="ltr" placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-black/5 dark:border-white/10 text-sm font-mono focus:ring-2 focus:ring-apple-blue outline-none" />
          </div>

          <div class="flex items-center justify-end gap-2 pt-2">
            <button type="button" id="cancel-change-password-btn" class="px-4 py-2 rounded-xl text-xs font-semibold text-neutral-600 dark:text-neutral-400 hover:bg-black/5 dark:hover:bg-white/5">انصراف</button>
            <button type="submit" id="submit-change-password-btn" class="px-5 py-2 rounded-xl bg-apple-blue hover:bg-blue-600 text-white text-xs font-bold transition-all shadow-md shadow-apple-blue/20">تغییر رمز</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Apple-styled UI Modal & Toast Notification System -->
    <UiModal />

    <script>
      import { authApi } from '../utils/api';
      import { showConfirm, showToast } from '../utils/ui-dialog';

      // Silent Token Refresh Mechanism (Every 4 minutes)
      function setupSilentRefresh() {
        setInterval(async () => {
          try {
            const isMock =
              document.cookie.includes('mock-demo-token') ||
              localStorage.getItem('AdminAuthToken') === 'mock-demo-token';
            if (isMock) {
              return; // Active mock demo session does not require remote token refresh
            }

            const res = await authApi.refresh();
            if (res.isSuccess) {
              console.log('[Auth] Session refreshed silently.');
            } else if (res.statusCode === 401) {
              localStorage.removeItem('admin_remember_me');
              window.location.href = '/admin/login';
            }
          } catch (e) {
            console.warn('[Auth] Silent refresh check skipped:', e);
          }
        }, 4 * 60 * 1000);
      }

      setupSilentRefresh();

      // Listen for comment count updates to keep sidebar badge in sync reactively
      window.addEventListener('comment-count-updated', (e: any) => {
        const delta = e?.detail?.delta ?? -1;
        const badge = document.getElementById('sidebar-comments-badge');
        if (!badge) return;
        const currentCount = parseInt(badge.textContent?.replace(/[^\d]/g, '') || '0', 10);
        const newCount = Math.max(0, currentCount + delta);
        if (newCount <= 0) {
          badge.classList.add('hidden');
          badge.textContent = '0';
        } else {
          badge.classList.remove('hidden');
          badge.textContent = newCount.toLocaleString('fa-IR');
        }
      });

      // Change Password Dialog Logic
      const cpModal = document.getElementById('change-password-modal');
      const headerCpBtn = document.getElementById('admin-change-password-btn');
      const sidebarCpBtn = document.getElementById('sidebar-change-password-btn');
      const closeCpBtn = document.getElementById('close-change-password-btn');
      const cancelCpBtn = document.getElementById('cancel-change-password-btn');
      const cpForm = document.getElementById('change-password-form') as HTMLFormElement | null;
      const cpErrorAlert = document.getElementById('cp-error-alert');
      const currentPwdInput = document.getElementById('current-password') as HTMLInputElement | null;
      const newPwdInput = document.getElementById('new-password') as HTMLInputElement | null;
      const confirmPwdInput = document.getElementById('confirm-password') as HTMLInputElement | null;
      const submitCpBtn = document.getElementById('submit-change-password-btn') as HTMLButtonElement | null;

      function openCpDialog() {
        if (cpModal) cpModal.classList.remove('hidden');
        if (cpErrorAlert) cpErrorAlert.classList.add('hidden');
        if (cpForm) cpForm.reset();
        currentPwdInput?.focus();
      }

      function closeCpDialog() {
        if (cpModal) cpModal.classList.add('hidden');
      }

      headerCpBtn?.addEventListener('click', openCpDialog);
      sidebarCpBtn?.addEventListener('click', openCpDialog);
      closeCpBtn?.addEventListener('click', closeCpDialog);
      cancelCpBtn?.addEventListener('click', closeCpDialog);

      // Close modal on Escape key press or clicking outside
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && cpModal && !cpModal.classList.contains('hidden')) {
          closeCpDialog();
        }
      });
      cpModal?.addEventListener('click', (e) => {
        if (e.target === cpModal) closeCpDialog();
      });

      cpForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const currentPassword = currentPwdInput?.value?.trim() || '';
        const newPassword = newPwdInput?.value || '';
        const confirmNewPassword = confirmPwdInput?.value || '';

        if (!currentPassword || !newPassword) {
          if (cpErrorAlert) {
            cpErrorAlert.textContent = 'کلمه عبور فعلی و کلمه عبور جدید الزامی هستند.';
            cpErrorAlert.classList.remove('hidden');
          }
          return;
        }

        if (newPassword.length < 8) {
          if (cpErrorAlert) {
            cpErrorAlert.textContent = 'کلمه عبور جدید باید حداقل ۸ کاراکتر باشد.';
            cpErrorAlert.classList.remove('hidden');
          }
          return;
        }

        if (newPassword !== confirmNewPassword) {
          if (cpErrorAlert) {
            cpErrorAlert.textContent = 'کلمه عبور جدید با تکرار آن مطابقت ندارد.';
            cpErrorAlert.classList.remove('hidden');
          }
          return;
        }

        if (submitCpBtn) {
          submitCpBtn.disabled = true;
          submitCpBtn.innerHTML = `
            <span class="inline-flex items-center gap-1.5">
              <svg class="animate-spin -ml-1 mr-1 h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span>در حال ثبت...</span>
            </span>
          `;
        }

        try {
          const res = await authApi.changePassword({ currentPassword, newPassword, confirmNewPassword });
          if (res.isSuccess) {
            showToast('کلمه عبور با موفقیت به‌روزرسانی شد.', 'success');
            if (cpForm) cpForm.reset();
            closeCpDialog();
          } else {
            if (cpErrorAlert) {
              cpErrorAlert.textContent = res.errorMessage || 'کلمه عبور فعلی نادرست است یا خطایی رخ داد.';
              cpErrorAlert.classList.remove('hidden');
            }
          }
        } catch (err: any) {
          if (cpErrorAlert) {
            cpErrorAlert.textContent = err?.message || 'خطا در برقراری ارتباط با سرور.';
            cpErrorAlert.classList.remove('hidden');
          }
        } finally {
          if (submitCpBtn) {
            submitCpBtn.disabled = false;
            submitCpBtn.textContent = 'تغییر رمز';
          }
        }
      });

      document.getElementById('admin-logout-btn')?.addEventListener('click', async () => {
        const confirmed = await showConfirm({
          title: 'خروج از حساب کاربری',
          message: 'آیا قصد خروج از پنل مدیریت را دارید؟',
          confirmText: 'خروج از حساب',
          cancelText: 'انصراف',
          isDestructive: true,
        });

        if (confirmed) {
          try {
            await authApi.logout();
          } catch (e) {}
          // Clear remember me flag and session
          localStorage.removeItem('admin_remember_me');
          document.cookie = 'AdminAuthToken=; Max-Age=0; path=/;';
          window.location.href = '/admin/login';
        }
      });
    </script>
  </body>
</html>
